// ============================================
// TEXTBOOK MODELS (existing)
// ============================================

model TextbookBook {
  id            String   @id @default(uuid())
  code          String
  version       Int      @default(1) // Version number
  name          String
  description   String?
  subject       String?  // Subject (e.g., "Toán", "Tiếng Việt")
  grade         String?  // Grade level (e.g., "Lớp 1")
  isActive      Boolean  @default(true)
  isApproved    Boolean  @default(false) // Approval status
  approvedAt    DateTime?
  approvedBy    String?
  tocStatus     String   @default("PENDING") // TOC status: PENDING, PROCESSING, COMPLETED, FAILED
  tocSource     String?  // TOC source: IMPORT, MANUAL, AI
  pdfPath       String?  // Path to the PDF file
  fileSize      BigInt?  // File size in bytes
  fileHash      String?  // File hash for deduplication
  pageCount     Int?     // Total pages in the textbook
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chapters        TextbookChapter[]
  teachingMethods TextbookTeachingMethod[]
  lessonMethods   LessonTeachingMethod[]
  indexJobs      TextbookIndexJob[]
  lessonPlans    LessonPlan[]

  @@unique([code, version])
}

model TextbookChapter {
  id            String   @id @default(uuid())
  bookId        String
  code          String
  name          String
  description   String?  @db.Text // Chapter description
  order         Int      @default(0)
  chapterNumber Int?     // Chapter number (1, 2, 3...)
  level         Int      @default(1) // Chapter level (1 = chapter, 2 = section, 3 = subsection)
  isActive      Boolean  @default(true)
  isApproved    Boolean  @default(false)
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedAt    DateTime?
  approvedBy    String?
  rejectionReason String?
  startPage     Int?     // Starting page number
  endPage       Int?     // Ending page number
  title         String?  // Alternative title
  aliases       String[] // Aliases for matching
  keywords      String[] // Keywords for search
  source        String?  // Source: IMPORT, MANUAL, AI
  confidence    Float?   // AI confidence score
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  book          TextbookBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  lessonMethods LessonTeachingMethod[]

  @@unique([bookId, code])
}

// Textbook Index Job - tracks indexing jobs for textbooks
model TextbookIndexJob {
  id              String   @id @default(uuid())
  bookId          String
  status          String   @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED
  progress        Int      @default(0) // Progress percentage (0-100)
  totalPages      Int?
  processedPages  Int?     @default(0)
  chaptersFound   Int?     @default(0)
  chaptersSaved   Int?     @default(0)
  extractionLog   Json?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  book            TextbookBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([status])
}

// Queue Job - Background job queue
model TextbookQueueJob {
  id            String   @id @default(uuid())
  type          String   // TEXTBOOK_INDEX, TEXTBOOK_EXTRACT, OCR_PROCESS, etc.
  status        String   @default("PENDING") // PENDING, RUNNING, PAUSED, COMPLETED, FAILED, RETRY, CANCELLED
  payload       Json?
  result        Json?
  error         String?
  progress      Int      @default(0)
  priority      Int      @default(0)
  retryCount    Int      @default(0)
  maxRetries    Int      @default(3)
  startedAt     DateTime?
  completedAt   DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([type, status])
  @@index([scheduledAt])
}

// Textbook Index - tracks indexed content from textbooks
model TextbookIndex {
  id            String   @id @default(uuid())
  bookId        String   @unique
  pdfHash       String
  indexedAt     DateTime @default(now())
  totalChapters Int      @default(0)
  status        String   @default("ACTIVE") // ACTIVE, ARCHIVED

  @@index([bookId])
}

// Textbook Chapter Index - tracks indexed content for each chapter
model TextbookChapterIndex {
  id            String   @id @default(uuid())
  chapterId     String   @unique
  indexId       String?
  contentHash   String
  indexedAt     DateTime @default(now())
  status        String   @default("ACTIVE") // ACTIVE, ARCHIVED

  @@index([chapterId])
  @@index([indexId])
}

// ============================================
// TEACHING METHOD MODELS
// ============================================

// Teaching Method - Main entity for teaching methods
model TeachingMethod {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?  @db.Text // Mô tả tổng quan

  // Teaching method details for AI Review
  objectives  String?  @db.Text // Mục tiêu - Learning objectives
  process    String?  @db.Text // Quy trình thực hiện - Implementation process
  advantages String?  @db.Text // Ưu điểm - Advantages/Benefits
  limitations String? @db.Text // Hạn chế - Limitations/Disadvantages
  conditions  String?  @db.Text // Điều kiện áp dụng - Application conditions
  examples   String?  @db.Text // Ví dụ minh họa - Examples

  // AI-specific fields for auto-selection and review
  keywords   String?  @db.Text // Từ khóa nhận diện - Keywords for AI matching
  indicators String?  @db.Text // Dấu hiệu nhận diện - Recognition indicators
  criteria   String?  @db.Text // Tiêu chí đánh giá - Evaluation criteria
  improvementSuggestions String?  @db.Text // Gợi ý cải thiện - Improvement suggestions

  // Sort and display
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations for AI auto-selection
  lessonMethods       LessonTeachingMethod[]
  activityMethods    ActivityTeachingMethod[]
  textbookMethods    TextbookTeachingMethod[]
  gradeLevelMethods  TeachingMethodGradeLevel[]
  subjectMethods     TeachingMethodSubject[]
  activityTypeMethods TeachingMethodActivity[]

  @@index([code])
  @@index([isActive])
  @@index([sortOrder])
}

// Link table: Teaching Method <-> Lesson
model LessonTeachingMethod {
  id                  String   @id @default(uuid())
  teachingMethodId    String
  lessonTitle         String?  // Title of the lesson (optional - can be linked to textbook instead)
  textbookBookId      String?  // Optional - can be linked to a textbook
  textbookChapterId   String?  // Optional - can be linked to a chapter

  // Priority and recommendation
  priority            Int      @default(0)  // Higher = more important
  isRecommended       Boolean  @default(false)
  note                String?  // Additional notes

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  teachingMethod      TeachingMethod   @relation(fields: [teachingMethodId], references: [id], onDelete: Cascade)
  textbookBook       TextbookBook?    @relation(fields: [textbookBookId], references: [id], onDelete: Cascade)
  textbookChapter    TextbookChapter? @relation(fields: [textbookChapterId], references: [id], onDelete: Cascade)

  @@unique([teachingMethodId, textbookBookId])
  @@unique([teachingMethodId, textbookChapterId])
  @@index([teachingMethodId])
  @@index([textbookBookId])
  @@index([textbookChapterId])
}

// Link table: Teaching Method <-> Activity
model ActivityTeachingMethod {
  id                  String   @id @default(uuid())
  teachingMethodId    String
  activityCode        String?  // Optional - specific activity code

  // Priority and recommendation
  priority            Int      @default(0)
  isRecommended       Boolean  @default(false)
  note                String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  teachingMethod      TeachingMethod   @relation(fields: [teachingMethodId], references: [id], onDelete: Cascade)

  @@index([teachingMethodId])
  @@index([activityCode])
}

// Link table: Teaching Method <-> Textbook
model TextbookTeachingMethod {
  id                  String   @id @default(uuid())
  teachingMethodId    String
  textbookBookId      String

  // Priority and recommendation
  priority            Int      @default(0)
  isRecommended       Boolean  @default(false)
  note                String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  teachingMethod      TeachingMethod   @relation(fields: [teachingMethodId], references: [id], onDelete: Cascade)
  textbookBook        TextbookBook     @relation(fields: [textbookBookId], references: [id], onDelete: Cascade)

  @@unique([teachingMethodId, textbookBookId])
  @@index([teachingMethodId])
  @@index([textbookBookId])
}

// Link table: Teaching Method <-> Grade Level (for AI auto-selection)
model TeachingMethodGradeLevel {
  id                String   @id @default(uuid())
  teachingMethodId  String
  gradeCode         String   // Grade level code (e.g., "1", "2", "3" for Grade 1, 2, 3)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  teachingMethod    TeachingMethod @relation(fields: [teachingMethodId], references: [id], onDelete: Cascade)

  @@unique([teachingMethodId, gradeCode])
  @@index([teachingMethodId])
  @@index([gradeCode])
}

// Link table: Teaching Method <-> Subject (for AI auto-selection)
model TeachingMethodSubject {
  id                String   @id @default(uuid())
  teachingMethodId  String
  subjectCode       String   // Subject code (e.g., "TOAN", "TIENG_VIET")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  teachingMethod    TeachingMethod @relation(fields: [teachingMethodId], references: [id], onDelete: Cascade)

  @@unique([teachingMethodId, subjectCode])
  @@index([teachingMethodId])
  @@index([subjectCode])
}

// Link table: Teaching Method <-> Activity Type (for AI auto-selection)
model TeachingMethodActivity {
  id                String   @id @default(uuid())
  teachingMethodId  String
  activityType      String   // Activity type (e.g., "KHAM_PHA", "LUYEN_TAP", "UNG_DUNG")

  priority         Int      @default(0)  // Higher = more important for this activity type
  isRecommended    Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  teachingMethod    TeachingMethod @relation(fields: [teachingMethodId], references: [id], onDelete: Cascade)

  @@unique([teachingMethodId, activityType])
  @@index([teachingMethodId])
  @@index([activityType])
}

// ============================================
// LESSON KNOWLEDGE MODELS
// ============================================

// Book - Bộ sách (e.g., "Chân trời sáng tạo", "Kết nối tri thức")
model LessonBook {
  id          String        @id @default(uuid())
  code        String        @unique // e.g., "CTST", "KNTT"
  name        String        // e.g., "Chân trời sáng tạo"
  description String?
  isActive    Boolean       @default(true)
  isDefault   Boolean       @default(false)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  grades     LessonGrade[]

  @@index([code])
  @@index([isActive])
}

// Grade - Lớp (e.g., Lớp 1, Lớp 2)
model LessonGrade {
  id          String        @id @default(uuid())
  bookId      String
  code        String        // e.g., "1", "2", "3"
  name        String        // e.g., "Lớp 1", "Lớp 2"
  order       Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  book        LessonBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  subjects    LessonSubject[]

  @@unique([bookId, code])
  @@index([bookId])
  @@index([isActive])
}

// Subject - Môn học (e.g., Toán, Tiếng Việt)
model LessonSubject {
  id          String        @id @default(uuid())
  gradeId     String
  code        String        // e.g., "TOAN", "TIENG_VIET"
  name        String        // e.g., "Toán", "Tiếng Việt"
  order       Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  grade       LessonGrade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([gradeId, code])
  @@index([gradeId])
  @@index([isActive])
}

// Lesson - Bài học (e.g., "Phép cộng trong phạm vi 10")
model Lesson {
  id            String              @id @default(uuid())
  subjectId     String
  code          String              // e.g., "LESSON_001"
  title         String
  description   String?
  order         Int                 @default(0)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  subject       LessonSubject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessonSections LessonSection[]

  @@unique([subjectId, code])
  @@index([subjectId])
  @@index([isActive])
}

// Lesson Section - Các phần trong bài học (e.g., "Khởi động", "Hình thành kiến thức")
model LessonSection {
  id            String              @id @default(uuid())
  lessonId      String
  code          String              // e.g., "WARM_UP", "KNOWLEDGE_FORMATION"
  name          String              // e.g., "Khởi động"
  description   String?
  order         Int                 @default(0)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  lesson        Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  activities    LessonActivity[]

  @@unique([lessonId, code])
  @@index([lessonId])
  @@index([isActive])
  @@index([code])
}

// Lesson Activity - Hoạt động cụ thể trong mỗi section
model LessonActivity {
  id                    String            @id @default(uuid())
  sectionId             String
  code                  String            // e.g., "ACT_001"
  title                 String
  order                 Int               @default(0)

  // Activity details
  summary               String?           // Tóm tắt hoạt động
  teachingIntent        String?           // Ý đồ sư phạm
  knowledge             String?           // Kiến thức cần đạt
  keywords              String[]          // Từ khóa để matching
  teachingMethod        String?           // Phương pháp dạy học

  // Expected actions
  expectedTeacherActions String?           // Hoạt động của GV
  expectedStudentActions String?           // Hoạt động của HS
  expectedOutcome       String?           // Kết quả mong đợi

  // Duration
  estimatedMinutes      Int?              // Thời gian ước tính

  // Matching features
  matchingPatterns      Json?             // Custom matching patterns
  aliases              String[]
  matchWeight          Float             @default(1.0) // Weight for scoring

  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  section              LessonSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  mappingResults       MappingResult[]

  @@unique([sectionId, code])
  @@index([sectionId])
  @@index([isActive])
  @@index([code])
}

// Mapping Result - Kết quả mapping từ document
model MappingResult {
  id                  String            @id @default(uuid())
  lessonPlanId        String
  activityId          String

  // Match information
  confidence          Float
  matchedBy           String            // ALIAS, KEYWORD, STRUCTURE, ORDER, MULTIPLE
  matchScore          Float?

  // Mapped data
  matchedActivity     Json?             // Copy of matched activity data

  // Document location
  documentSectionCode String?
  documentSectionTitle String?
  documentActivityTitle String?
  documentParagraphs   String[]

  isUnknown           Boolean           @default(false)
  createdAt          DateTime          @default(now())

  activity            LessonActivity    @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([lessonPlanId])
  @@index([activityId])
  @@index([confidence])
}

// Workflow Status Enum
enum WorkflowStatus {
  PENDING
  PARSING
  MAPPING
  BUILDING_CONTEXT
  AI_REVIEWING
  GENERATING_SUGGESTIONS
  COMPLETED
  FAILED
  CANCELLED
}

// Workflow Session - Tracks AI workflow execution
model WorkflowSession {
  id               String         @id @default(uuid())
  lessonPlanId     String
  userId           String
  status           WorkflowStatus @default(PENDING)
  currentStep      String         @default("PENDING")
  progress         Int            @default(0)
  parseResult      Json?
  mappingResult    Json?
  reviewResult     Json?
  annotationResult Json?
  suggestionResult Json?
  totalAiCalls     Int            @default(0)
  totalTokens      Int            @default(0)
  totalCost        Float          @default(0)
  executionTime    Int            @default(0)
  errorMessage     String?
  errorDetails     Json?
  result           Json?
  error            String?
  startedAt        DateTime?
  completedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([lessonPlanId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Workflow Step - Individual steps in a workflow
model WorkflowStep {
  id                String    @id @default(uuid())
  workflowSessionId String
  stepName          String
  status            String    @default("PENDING")
  progress          Int       @default(0)
  input             Json?
  output            Json?
  error             String?
  aiCalls           Int       @default(0)
  tokens            Int       @default(0)
  cost              Float     @default(0)
  executionTime     Int       @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([status])
  @@index([stepName])
  @@index([workflowSessionId])
}

// Textbook Cache Entry - Cache metadata for textbook PDF pages
model TextbookCacheEntry {
  chapterId   String    @id
  filePath    String
  fileSize    BigInt
  startPage   Int
  endPage     Int
  expiresAt   DateTime
  hitCount    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([expiresAt])
}
