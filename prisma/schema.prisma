generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                   @id @default(uuid())
  name                  String
  email                 String                   @unique
  password              String?
  role                  Role                     @default(LEARNER)
  status                UserStatus               @default(ACTIVE)
  licenseExpiresAt      DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  badges                String[]
  lastActiveDate        DateTime?
  level                 Int                      @default(1)
  streak                Int                      @default(0)
  xp                    Int                      @default(0)
  lastResetDate         DateTime                 @default(now())
  monthlyReviewsUsed    Int                      @default(0)
  pricingTier           PricingTier              @default(FREE)
  subscriptionEndDate   DateTime?
  subscriptionStartDate DateTime?
  accounts              Account[]
  resolvedAnnotations   Annotation[]
  bookmarks             Bookmark[]
  DocumentComment       DocumentComment[]
  DocumentSession       DocumentSession[]
  DocumentVersion       DocumentVersion[]
  customExams           Exam[]
  examAttempts          ExamAttempt[]
  exportHistory         ExportHistory[]
  feedbacks             Feedback[]
  lessonPlans           LessonPlan[]
  invitedCollaborators  LessonPlanCollaborator[] @relation("LessonPlanInviter")
  collaborations        LessonPlanCollaborator[] @relation("LessonPlanCollaborators")
  lessonPlanVersions    LessonPlanVersion[]
  activatedLicenses     License[]                @relation("ActivatedBy")
  passwordResetTokens   PasswordResetToken[]
  reviewHistory         ReviewHistory[]
  reviewedResults       ReviewResult[]
  createdRuleSets       ReviewRuleSet[]
  createdSectionRules   SectionRule[]
  sessions              Session[]
  usageLogs             UsageLog[]
  questionProgress      UserQuestionProgress[]
  wrongAnswers          UserWrongAnswer[]

  @@index([email])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model LoginAttempt {
  id         String   @id @default(uuid())
  userId     String?
  email      String
  ipAddress  String
  userAgent  String?
  success    Boolean
  failReason String?
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  event     String
  details   Json?
  ipAddress String
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@index([ipAddress, createdAt])
}

model Recruitment {
  id                  String            @id @default(uuid())
  title               String
  field               String?
  recruitmentType     String?
  status              RecruitmentStatus @default(OPEN)
  recruitmentYear     Int?
  province            String
  district            String?
  ward                String?
  organization        String
  applicationAddress  String?
  totalQuota          Int               @default(1)
  quotaDetails        Json?
  round1Format        String?
  round2Format        String?
  applicationStartDate DateTime?
  applicationEndDate  DateTime?
  notes               String?
  createdBy           String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([province])
  @@index([status])
  @@index([applicationEndDate])
  @@index([createdAt])
}

model License {
  id                String        @id @default(uuid())
  code              String        @unique
  durationDays      Int
  status            LicenseStatus @default(UNUSED)
  activatedAt       DateTime?
  activatedByUserId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  activatedBy       User?         @relation("ActivatedBy", fields: [activatedByUserId], references: [id])

  @@index([code])
}

model Category {
  id          String     @id @default(uuid())
  name        String
  description String?
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  exams       Exam[]
  questions   Question[]

  @@index([parentId])
}

model Question {
  id             String                 @id @default(uuid())
  content        String
  explanation    String?
  difficulty     Difficulty             @default(MEDIUM)
  categoryId     String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  bookmarks      Bookmark[]
  choices        Choice[]
  attemptAnswers ExamAttemptAnswer[]
  examQuestions  ExamQuestion[]
  category       Category               @relation(fields: [categoryId], references: [id])
  stats          QuestionStats?
  userProgress   UserQuestionProgress[]
  wrongAnswers   UserWrongAnswer[]

  @@index([categoryId])
  @@index([difficulty])
  @@index([categoryId, difficulty])
}

model Choice {
  id             String              @id @default(uuid())
  questionId     String
  content        String
  isCorrect      Boolean             @default(false)
  question       Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptAnswers ExamAttemptAnswer[]
}

model Exam {
  id            String         @id @default(uuid())
  title         String
  description   String?
  timeLimit     Int
  isPublished   Boolean        @default(false)
  matrix        Json?
  categoryId    String?
  isCustom      Boolean        @default(false)
  userId        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  category      Category?      @relation(fields: [categoryId], references: [id])
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts      ExamAttempt[]
  examQuestions ExamQuestion[]

  @@index([isPublished, categoryId])
  @@index([userId, isCustom])
}

model ExamQuestion {
  examId     String
  questionId String
  sortOrder  Int
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([examId, questionId])
}

model ExamAttempt {
  id           String              @id @default(uuid())
  userId       String
  examId       String
  score        Float
  correctCount Int
  totalCount   Int
  startedAt    DateTime            @default(now())
  submittedAt  DateTime?
  status       AttemptStatus       @default(IN_PROGRESS)
  savedAnswers Json?
  timeSpent    Int?
  exam         Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers      ExamAttemptAnswer[]

  @@index([userId])
  @@index([examId])
  @@index([status])
  @@index([userId, status])
  @@index([startedAt])
}

model ExamAttemptAnswer {
  id               String      @id @default(uuid())
  attemptId        String
  questionId       String
  selectedChoiceId String?
  isCorrect        Boolean     @default(false)
  timeSpent        Int?
  attempt          ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choice           Choice?     @relation(fields: [selectedChoiceId], references: [id])

  @@index([attemptId])
  @@index([questionId])
}

model UserWrongAnswer {
  id             String   @id @default(uuid())
  userId         String
  questionId     String
  wrongCount     Int      @default(1)
  lastAnsweredAt DateTime @default(now())
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, wrongCount])
}

model Bookmark {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

model UserQuestionProgress {
  id               String    @id @default(uuid())
  userId           String
  questionId       String
  timesEncountered Int       @default(0)
  timesCorrect     Int       @default(0)
  timesWrong       Int       @default(0)
  accuracy         Float     @default(0)
  avgTimeSpent     Float?
  lastReviewedAt   DateTime?
  masteryLevel     Int       @default(0)
  nextReviewDate   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  question         Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, masteryLevel])
  @@index([userId, nextReviewDate])
}

model QuestionStats {
  id                   String   @id @default(uuid())
  questionId           String   @unique
  totalAttempts        Int      @default(0)
  correctCount         Int      @default(0)
  wrongCount           Int      @default(0)
  successRate          Float    @default(0)
  avgTimeSpent         Float?
  calculatedDifficulty String?
  updatedAt            DateTime @updatedAt
  question             Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([successRate])
  @@index([calculatedDifficulty])
}

model Feedback {
  id         String         @id @default(uuid())
  userId     String
  subject    String
  message    String
  category   String?
  status     FeedbackStatus @default(PENDING)
  adminNote  String?
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Announcement {
  id        String    @id @default(uuid())
  content   String
  isActive  Boolean   @default(true)
  priority  Int       @default(0)
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive])
  @@index([priority])
  @@index([startDate])
}

model LessonPlan {
  id                   String                   @id @default(uuid())
  userId               String
  title                String
  subject              String?
  gradeLevel           String?
  schoolYear           String?
  circularId           String?
  textbookBookId       String?                  // Optional - can be linked to a textbook
  textbookLessonTitle  String?                  // Title of the lesson in the textbook
  originalFilename     String
  filePath             String
  fileSize             BigInt
  mimeType             String
  status               LessonPlanStatus         @default(UPLOADED)
  currentVersion       Int                      @default(1)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  deletedAt            DateTime?
  aiRequests           AIRequest[]
  DocumentComment      DocumentComment[]
  DocumentSession      DocumentSession[]
  DocumentVersion      DocumentVersion[]
  exportHistory        ExportHistory[]
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collaborators        LessonPlanCollaborator[]
  sections             LessonPlanSection[]
  versions             LessonPlanVersion[]
  reviewHistory        ReviewHistory[]
  reviewResults        ReviewResult[]
  usageLogs            UsageLog[]
  circular             CircularDocument?        @relation(fields: [circularId], references: [id])
  textbookBook         TextbookBook?            @relation(fields: [textbookBookId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([circularId])
  @@index([textbookBookId])
}

model LessonPlanCollaborator {
  id           String           @id @default(uuid())
  lessonPlanId String
  userId       String
  role         CollaboratorRole @default(VIEWER)
  addedBy      String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  inviter      User             @relation("LessonPlanInviter", fields: [addedBy], references: [id], onDelete: Cascade)
  lessonPlan   LessonPlan       @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  user         User             @relation("LessonPlanCollaborators", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonPlanId, userId])
  @@index([lessonPlanId])
  @@index([userId])
}

model LessonPlanVersion {
  id            String     @id @default(uuid())
  lessonPlanId  String
  versionNumber Int
  filePath      String
  fileSize      BigInt
  changeSummary String?
  createdBy     String
  createdAt     DateTime   @default(now())
  creator       User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  lessonPlan    LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)

  @@unique([lessonPlanId, versionNumber])
  @@index([lessonPlanId])
}

model LessonPlanSection {
  id              String            @id @default(uuid())
  lessonPlanId    String
  versionNumber   Int
  sectionType     String
  sectionTitle    String?
  sectionOrder    Int
  contentType     ContentType       @default(TEXT)
  rawContent      String
  parsedContent   Json?
  wordCount       Int?
  charCount       Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  metadata        Json?
  aiRequests      AIRequest[]
  annotations     Annotation[]
  DocumentComment DocumentComment[]
  lessonPlan      LessonPlan        @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)

  @@index([lessonPlanId])
  @@index([sectionType])
  @@index([sectionOrder])
}

model ReviewRuleSet {
  id            String         @id @default(uuid())
  name          String
  description   String?
  code          String         @unique
  version       String         @default("1.0")
  scope         String?
  isActive      Boolean        @default(true)
  isDefault     Boolean        @default(false)
  createdBy     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  aiRequests    AIRequest[]
  reviewResults ReviewResult[]
  rules         ReviewRule[]
  creator       User           @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([isActive])
  @@index([isDefault])
}

model ReviewRule {
  id                 String        @id @default(uuid())
  ruleSetId          String
  ruleCode           String
  ruleName           String
  description        String?
  category           String?
  severity           Severity      @default(WARNING)
  priority           Int           @default(0)
  applicableSections Json?
  aiPrompt           String
  validationCriteria Json?
  correctExamples    String?
  incorrectExamples  String?
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  annotations        Annotation[]
  ruleSet            ReviewRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@unique([ruleSetId, ruleCode])
  @@index([ruleSetId])
  @@index([category])
  @@index([severity])
  @@index([priority])
  @@index([isActive])
}

model AIRequest {
  id           String             @id @default(uuid())
  lessonPlanId String
  sectionId    String?
  ruleSetId    String?
  requestType  AIRequestType
  prompt       String
  inputTokens  Int?
  modelName    String             @default("gemini-1.5-pro")
  status       AIRequestStatus    @default(PENDING)
  errorMessage String?
  cacheKey     String?
  createdAt    DateTime           @default(now())
  completedAt  DateTime?
  lessonPlan   LessonPlan         @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  ruleSet      ReviewRuleSet?     @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  section      LessonPlanSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  response     AIResponse?

  @@index([lessonPlanId])
  @@index([sectionId])
  @@index([status])
  @@index([cacheKey])
  @@index([createdAt])
}

model AIResponse {
  id               String    @id @default(uuid())
  requestId        String    @unique
  responseData     Json
  outputTokens     Int?
  processingTimeMs Int?
  createdAt        DateTime  @default(now())
  request          AIRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model ReviewResult {
  id                       String          @id @default(uuid())
  lessonPlanId             String
  ruleSetId                String?
  overallScore             Decimal?        @db.Decimal(5, 2)
  totalIssues              Int             @default(0)
  criticalIssues           Int             @default(0)
  errorIssues              Int             @default(0)
  warningIssues            Int             @default(0)
  infoIssues               Int             @default(0)
  strengths                Json?
  weaknesses               Json?
  missingContent           Json?
  suggestions              Json?
  status                   ReviewStatus    @default(DRAFT)
  reviewedBy               String?
  reviewedAt               DateTime?
  teachingMethodAnalysis   Json?           // AI teaching method analysis result
  teachingMethodScore      Decimal?        @db.Decimal(5, 2) // Score for teaching method quality
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  metadata                 Json?
  annotations              Annotation[]
  exportHistory            ExportHistory[]
  lessonPlan               LessonPlan      @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  reviewer                 User?           @relation(fields: [reviewedBy], references: [id])
  ruleSet                  ReviewRuleSet?  @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@index([lessonPlanId])
  @@index([ruleSetId])
  @@index([status])
  @@index([overallScore])
}

model Annotation {
  id              String            @id @default(uuid())
  reviewResultId  String
  sectionId       String
  ruleId          String?
  annotationType  AnnotationType
  severity        Severity
  startPosition   Int
  endPosition     Int
  highlightedText String?
  message         String
  explanation     String?
  suggestion      String?
  proposedContent String?
  status          AnnotationStatus  @default(PENDING)
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  resolver        User?             @relation(fields: [resolvedBy], references: [id])
  reviewResult    ReviewResult      @relation(fields: [reviewResultId], references: [id], onDelete: Cascade)
  rule            ReviewRule?       @relation(fields: [ruleId], references: [id])
  section         LessonPlanSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  DocumentComment DocumentComment[]

  @@index([reviewResultId])
  @@index([sectionId])
  @@index([ruleId])
  @@index([annotationType])
  @@index([severity])
  @@index([status])
}

model SectionRule {
  id               String         @id @default(uuid())
  circularId       String?
  sectionType      String
  title            String
  requirements     String
  correctExample   String?
  incorrectExample String?
  aiPrompt         String
  priority         Int            @default(0)
  weight           Float          @default(1.0)
  level            Int            @default(3)  // 1=mục lớn, 2=mục nhỏ, 3=section, 4=subsection
  order            Int            @default(0)
  isActive         Boolean        @default(true)
  createdBy        String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  creator          User           @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  circular         CircularDocument? @relation(fields: [circularId], references: [id], onDelete: Cascade)
  parent           SectionRule?   @relation("SectionRuleHierarchy", fields: [parentId], references: [id])
  parentId         String?
  children         SectionRule[]  @relation("SectionRuleHierarchy")

  @@index([sectionType])
  @@index([isActive])
  @@index([priority])
  @@index([sectionType, isActive])
  @@index([circularId])
  @@index([parentId])
  @@index([level])
  @@index([order])
}

model ExportHistory {
  id                  String        @id @default(uuid())
  lessonPlanId        String
  reviewResultId      String?
  exportFormat        ExportFormat
  filePath            String
  fileSize            BigInt
  includeAnnotations  Boolean       @default(true)
  includeTrackChanges Boolean       @default(true)
  exportedBy          String
  createdAt           DateTime      @default(now())
  exporter            User          @relation(fields: [exportedBy], references: [id], onDelete: Cascade)
  lessonPlan          LessonPlan    @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  reviewResult        ReviewResult? @relation(fields: [reviewResultId], references: [id])

  @@index([lessonPlanId])
  @@index([reviewResultId])
  @@index([exportedBy])
  @@index([createdAt])
}

model ReviewHistory {
  id             String           @id @default(uuid())
  lessonPlanId   String
  reviewResultId String?
  actionType     ReviewActionType
  actionData     Json?
  performedBy    String
  createdAt      DateTime         @default(now())
  lessonPlan     LessonPlan       @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  performer      User             @relation(fields: [performedBy], references: [id], onDelete: Cascade)

  @@index([lessonPlanId])
  @@index([reviewResultId])
  @@index([actionType])
  @@index([performedBy])
  @@index([createdAt])
}

model UsageLog {
  id            String      @id @default(uuid())
  userId        String
  lessonPlanId  String?
  operationType String
  modelUsed     String
  inputTokens   Int
  outputTokens  Int
  totalCost     Float
  success       Boolean     @default(true)
  errorMessage  String?
  createdAt     DateTime    @default(now())
  lessonPlan    LessonPlan? @relation(fields: [lessonPlanId], references: [id])
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([lessonPlanId])
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  updatedAt   DateTime @default(now())

  @@index([key])
}

model EvaluationCriteria {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  level       String
  category    String
  description String?
  maxScore    Float
  criteria    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([level])
  @@index([isActive])
  @@index([level, category])
}

model CircularDocument {
  id                  String                       @id @default(uuid())
  code                String                       @unique
  title               String
  type                CircularType                 @default(GUIDELINE)
  content             String
  summary             String?
  issuedDate          DateTime
  effectiveDate       DateTime?
  applicableLevel     String[]
  applicableSubjects  String[]
  fileUrl             String?
  isActive            Boolean                      @default(true)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  sectionRequirements CircularSectionRequirement[]
  sectionRules        SectionRule[]
  lessonPlans         LessonPlan[]

  @@index([code])
  @@index([isActive])
  @@index([applicableLevel])
}

model SystemTheme {
  id        String   @id @default(cuid())
  theme     Json
  updatedBy String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([updatedAt])
}

model CircularSectionRequirement {
  id               String           @id @default(uuid())
  circularId       String
  sectionType      String
  title            String
  requirements     String
  correctExample   String?
  incorrectExample String?
  priority         Int              @default(0)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  aiPrompt         String?
  circular         CircularDocument @relation(fields: [circularId], references: [id], onDelete: Cascade)

  @@unique([circularId, sectionType])
  @@index([circularId])
  @@index([sectionType])
  @@index([isActive])
}

model DocumentComment {
  id                String             @id
  lessonPlanId      String
  sectionId         String?
  annotationId      String?
  paragraphId       String?
  startOffset       Int?
  endOffset         Int?
  commentText       String
  status            CommentStatus      @default(PENDING)
  severity          String
  reason            String?
  suggestion        String?
  rewriteContent    String?
  hasTrackChange    Boolean            @default(false)
  changeType        String?
  createdBy         String
  resolvedBy        String?
  resolvedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  Annotation        Annotation?        @relation(fields: [annotationId], references: [id])
  LessonPlan        LessonPlan         @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  User              User?              @relation(fields: [resolvedBy], references: [id])
  LessonPlanSection LessonPlanSection? @relation(fields: [sectionId], references: [id])

  @@index([annotationId])
  @@index([lessonPlanId])
  @@index([sectionId])
  @@index([status])
}

model DocumentSession {
  id           String                @id
  lessonPlanId String
  documentKey  String                @unique
  fileUrl      String
  userId       String
  status       DocumentSessionStatus @default(EDITING)
  callbackUrl  String?
  title        String
  fileType     String                @default("docx")
  editingUsers String[]
  lastModified DateTime
  version      Int                   @default(1)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime
  LessonPlan   LessonPlan            @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  User         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentKey])
  @@index([lessonPlanId])
  @@index([userId])
}

model DocumentVersion {
  id            String     @id
  lessonPlanId  String
  versionNumber Int
  filePath      String
  fileUrl       String
  fileSize      BigInt
  fileHash      String
  changeSummary String?
  changesCount  Int        @default(0)
  commentsCount Int        @default(0)
  createdBy     String
  isPublished   Boolean    @default(false)
  createdAt     DateTime   @default(now())
  User          User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  LessonPlan    LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)

  @@unique([lessonPlanId, versionNumber])
  @@index([createdBy])
  @@index([lessonPlanId])
}

model rule_change_versions {
  id         String   @id
  ruleType   String
  ruleId     String
  version    Int
  data       Json
  changedBy  String?
  changeNote String?
  createdAt  DateTime @default(now())

  @@index([ruleType, ruleId])
  @@index([version])
}

model rule_template_sections {
  id                      String                    @id
  templateId              String
  code                    String
  name                    String
  aliases                 String?                   // JSON array of alternative names: ["Mục tiêu", "Muc tieu", "Mục tiêu bài học"]
  order                   Int
  isRequired              Boolean                   @default(true)
  isRepeatable            Boolean                   @default(false)
  numberingStyle          String?
  headingLevel            Int?
  parentId                String?
  level                   Int                       @default(1)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  rule_templates          rule_templates            @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parent                  rule_template_sections?   @relation("SectionHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children                rule_template_sections[]  @relation("SectionHierarchy")
  section_content_rules   section_content_rules[]
  section_parser_rules    section_parser_rules[]
  section_structure_rules section_structure_rules[]

  @@unique([templateId, code])
  @@index([templateId, order])
  @@index([parentId])
}

model rule_templates {
  id                      String                    @id
  code                    String                    @unique
  name                    String
  description             String?
  category                String?
  isActive                Boolean                   @default(true)
  isDefault               Boolean                   @default(false)
  version                 Int                       @default(1)
  createdBy               String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  rule_template_sections  rule_template_sections[]
  section_content_rules   section_content_rules[]
  section_fix_rules       section_fix_rules[]
  section_parser_rules    section_parser_rules[]
  section_scoring_rules   section_scoring_rules[]
  section_structure_rules section_structure_rules[]

  @@index([code])
  @@index([isActive])
}

model rule_usage_history {
  id             String        @id
  ruleType       String
  ruleId         String
  lessonPlanId   String
  sectionId      String?
  matched        Boolean
  confidence     Float?
  aiUsed         Boolean       @default(false)
  executionTime  Int?
  userFeedback   FeedbackType?
  improvedRuleId String?
  createdAt      DateTime      @default(now())

  @@index([aiUsed])
  @@index([lessonPlanId])
  @@index([ruleId, matched])
}

model section_content_rules {
  id                     String                 @id
  templateId             String
  sectionId              String
  code                   String
  name                   String
  description            String?
  checkType              ContentCheckType
  severity               RuleSeverity
  systemPrompt           String
  userPrompt             String
  criteria               Json?
  penaltyScore           Int                    @default(0)
  useAI                  Boolean                @default(true)
  aiModel                String                 @default("gemini-3.1-flash-lite")
  maxTokens              Int?                   @default(500)
  temperature            Float?                 @default(0.3)
  isActive               Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime
  rule_template_sections rule_template_sections @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  rule_templates         rule_templates         @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([checkType])
  @@index([templateId, sectionId])
}

model section_fix_rules {
  id               String         @id
  templateId       String
  code             String
  name             String
  description      String?
  issueType        String
  issueSeverity    RuleSeverity
  fixType          FixType
  fixTemplate      String?
  aiPrompt         String?
  aiModel          String?        @default("gemini-3.1-flash-lite")
  instructions     String?
  autoApply        Boolean        @default(false)
  requiresApproval Boolean        @default(true)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  rule_templates   rule_templates @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, issueType])
}

model section_parser_rules {
  id                     String                 @id
  templateId             String
  sectionId              String
  type                   ParserType
  pattern                String
  priority               Int                    @default(100)
  ignoreCase             Boolean                @default(true)
  ignoreAccent           Boolean                @default(true)
  ignoreSpace            Boolean                @default(false)
  normalizeText          Boolean                @default(true)
  fuzzyThreshold         Float?
  aliases                String[]
  isActive               Boolean                @default(true)
  confidence             Float                  @default(1.0)
  learnedFromAI          Boolean                @default(false)
  usageCount             Int                    @default(0)
  successCount           Int                    @default(0)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime
  rule_template_sections rule_template_sections @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  rule_templates         rule_templates         @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([priority])
  @@index([sectionId])
  @@index([templateId, type])
}

model section_scoring_rules {
  id             String         @id
  templateId     String
  code           String
  name           String
  description    String?
  issueType      String
  severity       RuleSeverity
  penalty        Int
  conditions     Json?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  rule_templates rule_templates @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([severity])
  @@index([templateId, issueType])
}

model section_structure_rules {
  id                     String                  @id
  templateId             String
  sectionId              String?
  code                   String
  name                   String
  description            String?
  type                   StructureCheckType
  severity               RuleSeverity
  expectedValue          Json?
  allowedValues          Json?
  penaltyScore           Int                     @default(0)
  errorMessage           String?
  suggestionText         String?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  rule_template_sections rule_template_sections? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  rule_templates         rule_templates          @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([severity])
  @@index([templateId, type])
}

