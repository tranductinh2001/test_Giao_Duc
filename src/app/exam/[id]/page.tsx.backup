"use client";

import React, { useCallback, useEffect, useMemo, useRef, useState } from "react";
import Link from "next/link";
import { useParams } from "next/navigation";
import toast from "react-hot-toast";
import Button from "@/components/ui/button";
import {
  Clock,
  CheckCircle,
  XCircle,
  AlertCircle,
  BookOpen,
  Target,
  Award,
  TrendingUp,
  ArrowLeft,
  ArrowRight,
  Lightbulb,
  Filter,
  Home,
  BarChart3,
  Star,
  Circle
} from "lucide-react";

interface ExamChoice {
  id: string;
  content: string;
}

interface ExamQuestion {
  id: string;
  content: string;
  difficulty: "EASY" | "MEDIUM" | "HARD";
  categoryName: string | null;
  choices: ExamChoice[];
}

interface StartAttemptResponse {
  attemptId: string;
  timeLimit: number;
  questions: ExamQuestion[];
  bookmarkedQuestionIds: string[];
}

interface ReviewAnswer {
  questionId: string;
  question: {
    content: string;
    explanation: string | null;
    category: { name: string } | null;
    choices: { id: string; content: string; isCorrect: boolean }[];
  };
  selectedChoiceId: string | null;
  isCorrect: boolean;
}

interface CategoryStats {
  categoryId: string;
  categoryName: string;
  totalQuestions: number;
  correctAnswers: number;
  accuracy: number;
}

interface AttemptAnalysis {
  score: number;
  correctCount: number;
  totalCount: number;
  categoryStats: CategoryStats[];
  weakCategories: CategoryStats[];
  recommendations: string[];
}

interface SubmitResult {
  score: number;
  correctCount: number;
  totalCount: number;
  isExpired: boolean;
}

const DIFFICULTY_LABEL: Record<string, string> = {
  EASY: "Dễ",
  MEDIUM: "Trung bình",
  HARD: "Khó",
};

function formatTime(totalSeconds: number) {
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = totalSeconds % 60;
  return `${minutes.toString().padStart(2, "0")}:${seconds.toString().padStart(2, "0")}`;
}

// Result Panel Component
function ResultPanel({
  result,
  attemptId,
}: {
  result: SubmitResult;
  attemptId: string;
}) {
  const [reviews, setReviews] = useState<ReviewAnswer[] | null>(null);
  const [reviewLoading, setReviewLoading] = useState(false);
  const [showReview, setShowReview] = useState(false);
  const [filter, setFilter] = useState<"all" | "wrong" | "correct">("all");
  const [analysis, setAnalysis] = useState<AttemptAnalysis | null>(null);
  const [analysisLoading, setAnalysisLoading] = useState(false);

  const passed = result.score >= 50;
  const percentage = result.score;

  const loadAnalysis = async () => {
    if (analysis) return;
    setAnalysisLoading(true);
    try {
      const res = await fetch(`/api/attempts/${attemptId}/analytics`);
      const data = await res.json();
      if (data.success) {
        setAnalysis(data.data);
      }
    } finally {
      setAnalysisLoading(false);
    }
  };

  const loadReview = async () => {
    if (reviews) {
      setShowReview(true);
      return;
    }
    setReviewLoading(true);
    try {
      const res = await fetch(`/api/attempts/${attemptId}/submit`);
      const data = await res.json();
      if (data.success) {
        setReviews(data.data.answers || []);
        setShowReview(true);
      }
    } finally {
      setReviewLoading(false);
    }
  };

  useEffect(() => {
    loadAnalysis();
  }, []);

  const filteredReviews = useMemo(() => {
    if (!reviews) return [];
    if (filter === "wrong") return reviews.filter((r) => !r.isCorrect);
    if (filter === "correct") return reviews.filter((r) => r.isCorrect);
    return reviews;
  }, [reviews, filter]);

  return (
    <div className="min-h-screen bg-background">
      {/* Score Banner - enhanced design */}
      <div className="bg-card border-b border-border">
        <div className="container mx-auto max-w-5xl px-4 py-12">
          <p className="text-xs uppercase tracking-wider text-muted-foreground font-bold text-center mb-8">
            Kết quả bài thi
          </p>

          {/* Circular score - enhanced */}
          <div className="flex justify-center mb-8">
            <div className="relative flex h-40 w-40 items-center justify-center">
              <svg className="absolute inset-0 h-full w-full -rotate-90" viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="44" fill="none" stroke="currentColor" strokeWidth="8" className="text-muted" />
                <circle
                  cx="50"
                  cy="50"
                  r="44"
                  fill="none"
                  stroke="currentColor"
                  strokeWidth="8"
                  strokeLinecap="round"
                  strokeDasharray={`${2 * Math.PI * 44}`}
                  strokeDashoffset={`${2 * Math.PI * 44 * (1 - percentage / 100)}`}
                  className={`transition-all duration-1000 ${passed ? "text-success" : "text-destructive"}`}
                />
              </svg>
              <div className="text-center">
                <span className={`text-5xl font-bold ${passed ? "text-success" : "text-destructive"}`}>
                  {Math.round(percentage)}
                </span>
                <span className="ml-1 text-lg text-muted-foreground">/100</span>
              </div>
            </div>
          </div>

          <div className="text-center space-y-2 mb-8">
            <div className="flex items-center justify-center gap-2">
              {passed ? (
                <CheckCircle className="w-6 h-6 text-success" />
              ) : (
                <XCircle className="w-6 h-6 text-destructive" />
              )}
              <p className={`text-2xl font-bold ${passed ? "text-success" : "text-destructive"}`}>
                {passed ? "Đạt yêu cầu" : "Chưa đạt"}
              </p>
            </div>
            <p className="text-sm text-muted-foreground">
              Trả lời đúng{" "}
              <span className="font-bold text-foreground">
                {result.correctCount}/{result.totalCount}
              </span>{" "}
              câu hỏi
              {result.isExpired && (
                <span className="ml-2 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-warning/10 text-warning border border-warning/20">
                  <Clock className="w-3 h-3" />
                  Nộp quá giờ
                </span>
              )}
            </p>
          </div>

          {/* Stats row - enhanced cards */}
          <div className="grid grid-cols-3 gap-4 max-w-2xl mx-auto mb-8">
            <div className="bg-card border border-primary/20 rounded-xl p-5 text-center hover:shadow-elevated transition-shadow">
              <Target className="w-6 h-6 text-primary mx-auto mb-2" />
              <p className="text-3xl font-bold text-primary mb-1">{Math.round(percentage)}</p>
              <p className="text-xs font-medium text-muted-foreground">Điểm số</p>
            </div>

            <div className="bg-card border border-success/20 rounded-xl p-5 text-center hover:shadow-elevated transition-shadow">
              <CheckCircle className="w-6 h-6 text-success mx-auto mb-2" />
              <p className="text-3xl font-bold text-success mb-1">{result.correctCount}</p>
              <p className="text-xs font-medium text-muted-foreground">Câu đúng</p>
            </div>

            <div className="bg-card border border-destructive/20 rounded-xl p-5 text-center hover:shadow-elevated transition-shadow">
              <XCircle className="w-6 h-6 text-destructive mx-auto mb-2" />
              <p className="text-3xl font-bold text-destructive mb-1">{result.totalCount - result.correctCount}</p>
              <p className="text-xs font-medium text-muted-foreground">Câu sai</p>
            </div>
          </div>

          {/* Actions */}
          <div className="flex flex-wrap items-center justify-center gap-3">
            <Button
              onClick={loadReview}
              variant="primary"
              size="lg"
              isLoading={reviewLoading}
              leftIcon={<BookOpen className="w-4 h-4" />}
            >
              Xem đáp án chi tiết
            </Button>
            <Link href="/dashboard/exams">
              <Button variant="secondary" size="lg" leftIcon={<Home className="w-4 h-4" />}>
                Trung tâm thi
              </Button>
            </Link>
            <Link href="/dashboard/insights">
              <Button variant="ghost" size="lg" leftIcon={<BarChart3 className="w-4 h-4" />}>
                Báo cáo
              </Button>
            </Link>
          </div>
        </div>
      </div>

      {/* Category Analysis Section */}
      {analysis && (
        <div className="container mx-auto max-w-5xl px-4 py-8 space-y-6">
          {/* Recommendations */}
          <div className="bg-card border border-primary/20 rounded-xl p-6 shadow-subtle">
            <div className="flex items-center gap-2 mb-4">
              <Lightbulb className="w-5 h-5 text-primary" />
              <h3 className="text-base font-bold text-primary">Lời khuyên cho bạn</h3>
            </div>
            <ul className="space-y-2 text-sm text-foreground">
              {analysis.recommendations.map((rec, i) => (
                <li key={i} className="flex gap-3">
                  <span className="text-primary mt-1">•</span>
                  <span>{rec}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* Category Stats */}
          <div className="bg-card border border-border rounded-xl p-6 shadow-subtle">
            <div className="flex items-center gap-2 mb-4">
              <BarChart3 className="w-5 h-5 text-primary" />
              <h3 className="text-base font-bold text-foreground">Phân tích theo chuyên đề</h3>
            </div>
            <div className="space-y-4">
              {analysis.categoryStats.map((cat) => (
                <div key={cat.categoryId} className="space-y-2">
                  <div className="flex items-center justify-between text-sm">
                    <span className="font-bold text-foreground">{cat.categoryName}</span>
                    <span className="text-xs font-medium text-muted-foreground">
                      {cat.correctAnswers}/{cat.totalQuestions} câu ({cat.accuracy}%)
                    </span>
                  </div>
                  <div className="h-2 overflow-hidden rounded-full bg-muted">
                    <div
                      className={`h-full rounded-full transition-all duration-500 ${
                        cat.accuracy >= 80
                          ? "bg-success"
                          : cat.accuracy >= 60
                          ? "bg-warning"
                          : "bg-destructive"
                      }`}
                      style={{ width: `${cat.accuracy}%` }}
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Weak Categories */}
          {analysis.weakCategories.length > 0 && (
            <div className="bg-card border border-destructive/20 rounded-xl p-6 shadow-subtle">
              <div className="flex items-center gap-2 mb-4">
                <AlertCircle className="w-5 h-5 text-destructive" />
                <h3 className="text-base font-bold text-destructive">Chuyên đề cần ôn tập</h3>
              </div>
              <div className="space-y-3">
                {analysis.weakCategories.map((cat) => (
                  <div
                    key={cat.categoryId}
                    className="flex items-center justify-between rounded-lg border border-destructive/30 bg-destructive/5 px-4 py-3"
                  >
                    <span className="text-sm font-medium text-foreground">{cat.categoryName}</span>
                    <span className="text-lg font-bold text-destructive">{cat.accuracy}%</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      )}

      {/* Review section */}
      {showReview && reviews && (
        <div className="container mx-auto max-w-5xl px-4 py-8 space-y-6">
          <div className="flex flex-wrap items-center justify-between gap-4">
            <div className="flex items-center gap-2">
              <BookOpen className="w-5 h-5 text-primary" />
              <h2 className="text-lg font-bold text-foreground">Xem lại đáp án</h2>
            </div>

            <div className="flex items-center gap-2">
              <Filter className="w-4 h-4 text-muted-foreground" />
              <div className="flex gap-2">
                {(["all", "correct", "wrong"] as const).map((f) => (
                  <button
                    key={f}
                    onClick={() => setFilter(f)}
                    className={`h-9 px-4 rounded-lg text-xs font-bold transition ${
                      filter === f
                        ? "bg-primary text-white"
                        : "bg-muted text-muted-foreground hover:bg-muted/80"
                    }`}
                  >
                    {f === "all" ? "Tất cả" : f === "correct" ? "Đúng" : "Sai"}
                  </button>
                ))}
              </div>
            </div>
          </div>

          <div className="space-y-4">
            {filteredReviews.map((review, index) => {
              const correctChoice = review.question.choices.find((c) => c.isCorrect);
              return (
                <div
                  key={review.questionId}
                  className={`bg-card border rounded-xl p-6 shadow-subtle ${
                    review.isCorrect
                      ? "border-success/30"
                      : "border-destructive/30"
                  }`}
                >
                  <div className="flex items-start gap-3 mb-4">
                    <div
                      className={`flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg font-bold text-sm ${
                        review.isCorrect
                          ? "bg-success text-white"
                          : "bg-destructive text-white"
                      }`}
                    >
                      {index + 1}
                    </div>
                    <div className="flex-1">
                      <div
                        className="text-sm leading-relaxed text-foreground font-medium"
                        dangerouslySetInnerHTML={{ __html: review.question.content }}
                      />
                    </div>
                  </div>

                  <div className="space-y-2">
                    {review.question.choices.map((choice, ci) => {
                      const isSelected = review.selectedChoiceId === choice.id;
                      const isCorrectChoice = choice.isCorrect;
                      return (
                        <div
                          key={choice.id}
                          className={`flex items-center gap-3 rounded-lg border p-3 text-sm ${
                            isCorrectChoice
                              ? "border-success/40 bg-success/5 text-foreground"
                              : isSelected && !isCorrectChoice
                              ? "border-destructive/40 bg-destructive/5 text-foreground"
                              : "border-border bg-muted text-muted-foreground"
                          }`}
                        >
                          <span className="font-mono text-xs font-bold flex-shrink-0">
                            {String.fromCharCode(65 + ci)}.
                          </span>
                          <span className="flex-1 font-medium">{choice.content}</span>
                          {isCorrectChoice && (
                            <CheckCircle className="w-4 h-4 text-success flex-shrink-0" />
                          )}
                          {isSelected && !isCorrectChoice && (
                            <XCircle className="w-4 h-4 text-destructive flex-shrink-0" />
                          )}
                        </div>
                      );
                    })}
                  </div>

                  {review.question.explanation && (
                    <div className="mt-4 rounded-lg border border-primary/20 bg-primary/5 p-4">
                      <div className="flex items-start gap-2">
                        <Lightbulb className="w-4 h-4 text-primary flex-shrink-0 mt-0.5" />
                        <div>
                          <p className="text-xs font-bold uppercase tracking-wide text-primary mb-1">Giải thích</p>
                          <p className="text-sm leading-relaxed text-foreground">
                            {review.question.explanation}
                          </p>
                        </div>
                      </div>
                    </div>
                  )}

                  {!review.isCorrect && correctChoice && (
                    <p className="mt-3 text-xs text-muted-foreground">
                      Đáp án đúng:{" "}
                      <span className="font-bold text-success">
                        {correctChoice.content}
                      </span>
                    </p>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  );
}

// Main Exam Room Component
export default function ExamRoomPage() {
  const params = useParams();
  const examId = params.id as string;

  const [loading, setLoading] = useState(true);
  const [attemptId, setAttemptId] = useState<string | null>(null);
  const [questions, setQuestions] = useState<ExamQuestion[]>([]);
  const [currentIndex, setCurrentIndex] = useState(0);
  const [answers, setAnswers] = useState<Record<string, string>>({});
  const [bookmarks, setBookmarks] = useState<Set<string>>(new Set());
  const [timeLeft, setTimeLeft] = useState(0);
  const [result, setResult] = useState<SubmitResult | null>(null);
  const [submitting, setSubmitting] = useState(false);

  const autoSaveIntervalRef = useRef<NodeJS.Timeout | null>(null);
  const hasStartedRef = useRef(false);
  const autoSubmitIntervalRef = useRef<NodeJS.Timeout | null>(null);

  // Start attempt
  useEffect(() => {
    if (!examId || hasStartedRef.current) return;
    hasStartedRef.current = true;

    const startAttempt = async () => {
      try {
        const res = await fetch(`/api/exams/${examId}/start`, { method: "POST" });
        const data: { success: boolean; data?: StartAttemptResponse; message?: string } = await res.json();

        if (data.success && data.data) {
          setAttemptId(data.data.attemptId);
          setQuestions(data.data.questions);
          setTimeLeft(data.data.timeLimit);
          setBookmarks(new Set(data.data.bookmarkedQuestionIds));
        } else {
          toast.error(data.message || "Không thể bắt đầu bài thi");
        }
      } catch {
        toast.error("Lỗi kết nối máy chủ");
      } finally {
        setLoading(false);
      }
    };

    startAttempt();
  }, [examId]);

  // Timer countdown
  useEffect(() => {
    if (timeLeft <= 0 || result) return;

    const timer = setInterval(() => {
      setTimeLeft((prev) => {
        if (prev <= 1) {
          clearInterval(timer);
          handleSubmit(true);
          return 0;
        }
        return prev - 1;
      });
    }, 1000);

    return () => clearInterval(timer);
  }, [timeLeft, result]);

  // Auto-save every 30s
  useEffect(() => {
    if (!attemptId || result) return;

    autoSaveIntervalRef.current = setInterval(() => {
      saveProgress();
    }, 30000);

    return () => {
      if (autoSaveIntervalRef.current) clearInterval(autoSaveIntervalRef.current);
    };
  }, [attemptId, answers, bookmarks, result]);

  const saveProgress = async () => {
    if (!attemptId) return;
    try {
      await fetch(`/api/attempts/${attemptId}/save`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          answers: Object.entries(answers).map(([questionId, choiceId]) => ({
            questionId,
            choiceId,
          })),
          bookmarkedQuestionIds: Array.from(bookmarks),
        }),
      });
    } catch {
      // Silent fail
    }
  };

  const handleSubmit = async (autoSubmit = false) => {
    if (submitting || !attemptId) return;
    setSubmitting(true);

    try {
      await saveProgress();

      // Prepare answers in the correct format
      const answersArray = Object.entries(answers).map(([questionId, selectedChoiceId]) => ({
        questionId,
        selectedChoiceId: selectedChoiceId || null,
      }));

      const res = await fetch(`/api/attempts/${attemptId}/submit`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ answers: answersArray }),
      });

      const data = await res.json();

      if (data.success) {
        setResult(data.data);
        if (autoSubmitIntervalRef.current) clearInterval(autoSubmitIntervalRef.current);
        toast.success(
          autoSubmit
            ? "⏰ Đã nộp bài tự động do hết thời gian"
            : "🎉 Nộp bài thành công!",
          {
            duration: 3000,
            style: {
              background: 'hsl(var(--color-success))',
              color: 'hsl(var(--color-success-foreground))',
              fontWeight: '600',
            },
          }
        );
      } else {
        // Show specific error message
        const errorMessage = data.message || data.error || "Không thể nộp bài";
        toast.error(errorMessage, {
          duration: 4000,
          style: {
            background: 'hsl(var(--color-destructive))',
            color: 'hsl(var(--color-destructive-foreground))',
            fontWeight: '600',
          },
        });
      }
    } catch (error) {
      console.error("Submit error:", error);
      toast.error("❌ Không thể kết nối đến máy chủ. Vui lòng kiểm tra kết nối Internet.", {
        duration: 5000,
        style: {
          background: 'hsl(var(--color-destructive))',
          color: 'hsl(var(--color-destructive-foreground))',
          fontWeight: '600',
        },
      });
    } finally {
      setSubmitting(false);
    }
  };

  const handleAnswer = (choiceId: string) => {
    setAnswers((prev) => ({
      ...prev,
      [questions[currentIndex].id]: choiceId,
    }));
  };

  const toggleBookmark = useCallback(() => {
    const qId = questions[currentIndex]?.id;
    if (!qId) return;

    setBookmarks((prev) => {
      const next = new Set(prev);
      const wasBookmarked = prev.has(qId);

      if (wasBookmarked) {
        next.delete(qId);
      } else {
        next.add(qId);
      }

      // Toast outside of setState
      setTimeout(() => {
        toast.success(wasBookmarked ? "Đã bỏ lưu câu hỏi" : "Đã lưu câu hỏi");
      }, 0);

      return next;
    });
  }, [currentIndex, questions]);

  // Keyboard shortcuts
  useEffect(() => {
    const handleKeyPress = (e: KeyboardEvent) => {
      if (result) return;

      if (e.key === "ArrowLeft" && currentIndex > 0) {
        setCurrentIndex((prev) => prev - 1);
      } else if (e.key === "ArrowRight" && currentIndex < questions.length - 1) {
        setCurrentIndex((prev) => prev + 1);
      } else if (e.key === " " && !e.ctrlKey && !e.shiftKey) {
        e.preventDefault();
        toggleBookmark();
      } else if (e.key >= "1" && e.key <= "4") {
        const choiceIndex = parseInt(e.key) - 1;
        const currentQ = questions[currentIndex];
        if (currentQ?.choices[choiceIndex]) {
          handleAnswer(currentQ.choices[choiceIndex].id);
        }
      }
    };

    window.addEventListener("keydown", handleKeyPress);
    return () => window.removeEventListener("keydown", handleKeyPress);
  }, [currentIndex, questions, result, toggleBookmark]);

  const currentQuestion = questions[currentIndex];
  const isBookmarked = currentQuestion ? bookmarks.has(currentQuestion.id) : false;
  const selectedChoiceId = currentQuestion ? answers[currentQuestion.id] : undefined;

  const answeredCount = Object.keys(answers).length;
  const progress = questions.length > 0 ? (answeredCount / questions.length) * 100 : 0;

  if (loading) {
    return (
      <div className="flex min-h-screen items-center justify-center bg-background">
        <div className="text-center">
          <div className="flex items-center justify-center gap-3 mb-4">
            <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
            <span className="text-muted-foreground font-medium">Đang tải đề thi...</span>
          </div>
        </div>
      </div>
    );
  }

  if (result && attemptId) {
    return <ResultPanel result={result} attemptId={attemptId} />;
  }

  if (!currentQuestion) {
    return (
      <div className="flex min-h-screen items-center justify-center bg-background">
        <div className="bg-card border border-border rounded-xl p-12 text-center shadow-subtle max-w-md">
          <div className="flex h-16 w-16 items-center justify-center rounded-full bg-destructive/10 border border-destructive/20 mx-auto mb-4">
            <AlertCircle className="w-8 h-8 text-destructive" />
          </div>
          <h3 className="text-lg font-bold text-foreground mb-2">Không tìm thấy câu hỏi</h3>
          <Link href="/dashboard/exams">
            <Button variant="primary" size="md" className="mt-6">
              Về trung tâm thi
            </Button>
          </Link>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-background">
      {/* Top Bar - Fixed */}
      <div className="sticky top-0 z-50 border-b border-border bg-card/95 backdrop-blur-sm shadow-sm">
        <div className="container mx-auto max-w-7xl flex items-center justify-between gap-4 px-4 py-3">
          {/* Timer */}
          <div className="flex items-center gap-3">
            <div
              className={`flex items-center gap-2 rounded-lg px-4 py-2 font-mono text-lg font-bold transition ${
                timeLeft < 300
                  ? "bg-destructive/10 text-destructive animate-pulse border border-destructive/20"
                  : timeLeft < 600
                  ? "bg-warning/10 text-warning border border-warning/20"
                  : "bg-primary/10 text-primary border border-primary/20"
              }`}
            >
              <Clock className="w-5 h-5" />
              <span>{formatTime(timeLeft)}</span>
            </div>
          </div>

          {/* Progress */}
          <div className="hidden md:flex flex-1 max-w-md flex-col gap-1">
            <p className="text-xs font-bold text-muted-foreground">
              Hoàn thành: {answeredCount}/{questions.length} câu
            </p>
            <div className="h-2 overflow-hidden rounded-full bg-muted">
              <div
                className="h-full rounded-full bg-primary transition-all duration-300"
                style={{ width: `${progress}%` }}
              />
            </div>
          </div>

          {/* Submit Button */}
          <Button
            onClick={() => {
              if (window.confirm("Bạn chắc chắn muốn nộp bài?")) {
                handleSubmit(false);
              }
            }}
            variant="success"
            size="md"
            isLoading={submitting}
          >
            Nộp bài
          </Button>
        </div>
      </div>

      {/* Main Content */}
      <div className="container mx-auto max-w-7xl grid lg:grid-cols-[1fr_300px] gap-6 px-4 py-6">
        {/* Left: Question */}
        <div className="space-y-6">
          {/* Question Card */}
          <div className="bg-card border border-border rounded-xl p-6 shadow-subtle">
            <div className="mb-6 flex items-start justify-between gap-4">
              <div className="flex items-center gap-3">
                <div className="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-primary text-white text-lg font-bold">
                  {currentIndex + 1}
                </div>
                <div>
                  <h2 className="text-sm font-bold text-foreground">
                    Câu hỏi {currentIndex + 1}/{questions.length}
                  </h2>
                  <div className="mt-1 flex items-center gap-2">
                    {currentQuestion.categoryName && (
                      <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-blue-50 dark:bg-blue-950/30 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800">
                        {currentQuestion.categoryName}
                      </span>
                    )}
                    <span
                      className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium border ${
                        currentQuestion.difficulty === "EASY"
                          ? "bg-success/10 text-success border-success/20"
                          : currentQuestion.difficulty === "MEDIUM"
                          ? "bg-warning/10 text-warning border-warning/20"
                          : "bg-destructive/10 text-destructive border-destructive/20"
                      }`}
                    >
                      {DIFFICULTY_LABEL[currentQuestion.difficulty]}
                    </span>
                  </div>
                </div>
              </div>

              <button
                onClick={toggleBookmark}
                className={`flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg transition-all ${
                  isBookmarked
                    ? "bg-warning text-white scale-110"
                    : "border border-border text-muted-foreground hover:border-warning hover:text-warning"
                }`}
                title="Lưu câu hỏi (Space)"
              >
                <Star className={`w-5 h-5 ${isBookmarked ? "fill-current" : ""}`} />
              </button>
            </div>

            <div
              className="prose prose-sm max-w-none text-foreground leading-relaxed mb-6"
              dangerouslySetInnerHTML={{ __html: currentQuestion.content }}
            />

            {/* Choices */}
            <div className="space-y-3">
              {currentQuestion.choices.map((choice, index) => {
                const isSelected = selectedChoiceId === choice.id;
                return (
                  <button
                    key={choice.id}
                    onClick={() => handleAnswer(choice.id)}
                    className={`w-full rounded-lg border p-4 text-left transition-all ${
                      isSelected
                        ? "border-primary bg-primary/5 shadow-md"
                        : "border-border bg-card hover:border-primary hover:shadow-sm"
                    }`}
                  >
                    <div className="flex items-center gap-3">
                      <span
                        className={`flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg font-mono text-sm font-bold transition ${
                          isSelected
                            ? "bg-primary text-white"
                            : "border border-border text-muted-foreground"
                        }`}
                      >
                        {String.fromCharCode(65 + index)}
                      </span>
                      <span
                        className={`flex-1 font-medium ${
                          isSelected ? "text-primary" : "text-foreground"
                        }`}
                      >
                        {choice.content}
                      </span>
                      {isSelected && (
                        <CheckCircle className="w-5 h-5 text-primary" />
                      )}
                    </div>
                  </button>
                );
              })}
            </div>
          </div>

          {/* Navigation */}
          <div className="flex items-center justify-between gap-4">
            <Button
              onClick={() => setCurrentIndex((prev) => Math.max(0, prev - 1))}
              disabled={currentIndex === 0}
              variant="secondary"
              size="md"
              leftIcon={<ArrowLeft className="w-4 h-4" />}
            >
              Câu trước
            </Button>

            <p className="text-sm font-bold text-muted-foreground">
              {currentIndex + 1} / {questions.length}
            </p>

            <Button
              onClick={() => setCurrentIndex((prev) => Math.min(questions.length - 1, prev + 1))}
              disabled={currentIndex === questions.length - 1}
              variant="secondary"
              size="md"
              rightIcon={<ArrowRight className="w-4 h-4" />}
            >
              Câu sau
            </Button>
          </div>

          {/* Keyboard hints */}
          <div className="bg-card border border-blue-200 dark:border-blue-800 rounded-xl p-4 shadow-subtle">
            <div className="flex items-center gap-2 mb-3">
              <BookOpen className="w-4 h-4 text-blue-600 dark:text-blue-400" />
              <p className="text-xs font-bold text-blue-600 dark:text-blue-400">Phím tắt</p>
            </div>
            <div className="grid grid-cols-2 gap-2 text-xs text-foreground">
              <span>← → : Chuyển câu</span>
              <span>1-4 : Chọn đáp án A-D</span>
              <span>Space : Lưu câu hỏi</span>
            </div>
          </div>
        </div>

        {/* Right: Question Grid */}
        <div className="bg-card border border-border rounded-xl p-6 shadow-subtle sticky top-24 h-fit max-h-[calc(100vh-120px)] overflow-y-auto">
          <h3 className="text-base font-bold text-foreground mb-4">Danh sách câu hỏi</h3>

          <div className="mb-4 grid grid-cols-3 gap-2 text-xs">
            <div className="flex items-center gap-2">
              <div className="h-3 w-3 rounded-sm bg-primary" />
              <span className="text-muted-foreground">Đã chọn</span>
            </div>
            <div className="flex items-center gap-2">
              <div className="h-3 w-3 rounded-sm border border-border" />
              <span className="text-muted-foreground">Chưa chọn</span>
            </div>
            <div className="flex items-center gap-2">
              <Star className="w-3 h-3 text-warning fill-current" />
              <span className="text-muted-foreground">Đã lưu</span>
            </div>
          </div>

          <div className="grid grid-cols-5 gap-2">
            {questions.map((q, idx) => {
              const isAnswered = !!answers[q.id];
              const isCurrent = idx === currentIndex;
              const isMarked = bookmarks.has(q.id);

              return (
                <button
                  key={q.id}
                  onClick={() => setCurrentIndex(idx)}
                  className={`relative flex h-12 items-center justify-center rounded-lg border font-mono text-sm font-bold transition-all ${
                    isCurrent
                      ? "border-primary bg-primary text-white ring-4 ring-primary/30"
                      : isAnswered
                      ? "border-primary bg-primary/10 text-primary hover:bg-primary hover:text-white"
                      : "border-border text-muted-foreground hover:border-primary hover:bg-primary/5"
                  }`}
                >
                  {idx + 1}
                  {isMarked && (
                    <Star className="absolute -right-1 -top-1 w-3 h-3 text-warning fill-current" />
                  )}
                </button>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  );
}
