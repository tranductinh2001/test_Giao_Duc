}

    // Calculate Vision JSON character count for validation
    const visionCharacters = structuredPrompt.length;
    console.log('[SemanticReasoner] Vision JSON characters:', visionCharacters);

    // Count content items and calculate semantic characters
    let totalTeacherActions = 0;
    let totalStudentActions = 0;
    let totalProducts = 0;
    let totalAssessments = 0;
    let totalQuestions = 0;
    let totalActivities = 0;
    let semanticCharacters = 0;
    for (const section of sections) {
      totalActivities += section.activities?.length || 0;

      // Count section title
      semanticCharacters += (section.title?.length || 0);

      // Count activities
      for (const activity of section.activities || []) {
        totalTeacherActions += activity.teacherActions?.length || 0;
        totalStudentActions += activity.studentActions?.length || 0;
        totalProducts += activity.products?.length || 0;
        totalAssessments += activity.assessments?.length || 0;
        totalQuestions += activity.questions?.length || 0;

        semanticCharacters += (activity.title?.length || 0);
        semanticCharacters += (activity.goal?.length || 0);

        // Count paragraphs
        for (const para of activity.paragraphs || []) {
          semanticCharacters += (para.content?.length || 0);
        }

        // Count teacher actions
        for (const ta of activity.teacherActions || []) {
          semanticCharacters += (ta.action?.length || 0);
        }

        // Count student actions
        for (const sa of activity.studentActions || []) {
          semanticCharacters += (sa.action?.length || 0);
        }

        // Count questions
        for (const q of activity.questions || []) {
          semanticCharacters += (q.content?.length || 0);
        }

        // Count products
        for (const p of activity.products || []) {
          semanticCharacters += (p.description?.length || 0);
        }

        // Count assessments
        for (const a of activity.assessments || []) {
          semanticCharacters += (a.method?.length || 0);
        }
      }
    }

    const retention = visionCharacters > 0 ? (semanticCharacters / visionCharacters * 100).toFixed(1) : '0';

    console.log('[SemanticReasoner] Semantic Tree Stats:');
    console.log('[SemanticReasoner]   Vision Characters:', visionCharacters);
    console.log('[SemanticReasoner]   Semantic Characters:', semanticCharacters);
    console.log('[SemanticReasoner]   Retention:', retention + '%');
    console.log('[SemanticReasoner]   Sections:', sections.length);
    console.log('[SemanticReasoner]   Activities:', totalActivities);
    console.log('[SemanticReasoner]   TeacherActions:', totalTeacherActions);
    console.log('[SemanticReasoner]   StudentActions:', totalStudentActions);
    console.log('[SemanticReasoner]   Products:', totalProducts);
    console.log('[SemanticReasoner]   Assessments:', totalAssessments);
    console.log('[SemanticReasoner]   Questions:', totalQuestions);

    // FAIL if semantic data is missing or retention too low - this is CRITICAL
    if (sections.length === 0) {
      console.error('[SemanticReasoner] CRITICAL: Semantic parsing failed - no sections returned');
      console.error('[SemanticReasoner] Cannot continue - Semantic Tree is empty');

      return {
        success: false,
        confidence: 0,
        error: parseError || 'Semantic parsing failed - no sections returned',
      };
    }

    // WARNING if retention is too low - but don't fail, just warn
    if (parseFloat(retention) < 50) {
      console.warn('[SemanticReasoner] WARNING: Low retention (' + retention + '%) - may be summarizing content');
    }

    // Count total paragraphs
    let totalParagraphs = 0;
    for (const section of sections) {
      for (const activity of section.activities || []) {
        totalParagraphs += activity.paragraphs?.length || 0;
      }
    }

    console.log('[SemanticReasoner] Content Counts:');
    console.log('[SemanticReasoner]   Total Paragraphs:', totalParagraphs);
    console.log('[SemanticReasoner]   Total TeacherActions:', totalTeacherActions);
    console.log('[SemanticReasoner]   Total StudentActions:', totalStudentActions);
    console.log('[SemanticReasoner]   Total Products:', totalProducts);
    console.log('[SemanticReasoner]   Total Assessments:', totalAssessments);
    console.log('[SemanticReasoner]   Total Questions:', totalQuestions);

    // Build document tree
    const docId = 'doc-' + Date.now();
    const document: AIDocument = {
      id: docId,
      title: request.documentTitle || 'Untitled',
      metadata: {
        totalPages: visionData?.metadata?.totalPages,
        wordCount: visionData?.metadata?.wordCount || 0,
        language: 'vi',
      },
      sections: sections,
    };

    const confidence = this.calculateConfidence(sections);

    return {
      success: true,
      document,
      sections, // For backward compatibility
      tree: { sections } as DocumentTree, // Semantic tree
      pipelineMetrics: metrics,
      confidence,
    };
  }

  private buildVisionPrompt(visionData: any): string {
    const parts: string[] = [];

    // ============================================================
    // METADATA
    // ============================================================
    if (visionData?.metadata) {
      parts.push(`# METADATA`);
      parts.push(`Title: ${visionData.metadata.title || 'N/A'}`);
      parts.push(`Total Pages: ${visionData.metadata.totalPages || 'N/A'}`);
      parts.push(`Language: ${visionData.metadata.language || 'vi'}`);
      parts.push(`Has Tables: ${visionData.metadata.hasTables ? 'Yes' : 'No'}`);
      parts.push(`Has Images: ${visionData.metadata.hasImages ? 'Yes' : 'No'}`);
      parts.push(`Word Count: ${visionData.metadata.wordCount || 'N/A'}`);
      parts.push(`Confidence: ${(visionData.metadata.confidence || 0.9) * 100}%`);
    }

    // ============================================================
    // SECTIONS
    // ============================================================
    if (visionData?.sections?.length > 0) {
      parts.push(`\n# SECTIONS (${visionData.sections.length})`);
      for (const section of visionData.sections) {
        const pageRange = section.pageStart && section.pageEnd ? ` (trang ${section.pageStart}-${section.pageEnd})` : '';
        parts.push(`- ${section.title}${pageRange}`);
      }
    }

    // ============================================================
    // TABLES (CRITICAL for understanding structure)
    // ============================================================
    if (visionData?.tables?.length > 0) {
      parts.push(`\n# TABLES (${visionData.tables.length}) - ANALYZE CAREFULLY`);

      for (let i = 0; i < visionData.tables.length; i++) {
        const table = visionData.tables[i];
        parts.push(`\n## Table ${i + 1}`);

        // Table dimensions
        parts.push(`Columns: ${table.columnCount || table.headers?.length || 'N/A'}`);
        parts.push(`Rows: ${table.rowCount || table.rows?.length || 'N/A'}`);
        parts.push(`Page: ${table.pageNumber || 'N/A'}`);

        // Headers
        if (table.headers && table.headers.length > 0) {
          parts.push(`Headers: ${table.headers.join(' | ')}`);
        }

        // Merged cells - IMPORTANT for understanding column structure
        if (table.mergedCells && table.mergedCells.length > 0) {
          parts.push(`Merged Cells: ${table.mergedCells.length}`);
          for (const mc of table.mergedCells.slice(0, 5)) {
            parts.push(`  - Row ${mc.row}, Col ${mc.col}: rowSpan=${mc.rowSpan}, colSpan=${mc.colSpan}`);
          }
        }

        // Table data rows
        if (table.rows) {
          parts.push(`\nData Rows:`);
          for (const row of table.rows.slice(0, 8)) {
            parts.push(`  ${row.join(' | ')}`);
          }
          if (table.rows.length > 8) {
            parts.push(`  ... (${table.rows.length - 8} more rows)`);
          }
        }

        // Column analysis - CRITICAL for multi-column tables
        const colCount = table.columnCount || table.headers?.length || 0;
        if (colCount >= 2) {
          parts.push(`\n### COLUMN ANALYSIS`);
          if (colCount === 2) {
            parts.push(`Detected 2 columns - likely: Teacher | Student`);
          } else if (colCount === 3) {
            parts.push(`Detected 3 columns - likely: Teacher | Student | Product`);
          } else if (colCount >= 4) {
            parts.push(`Detected 4+ columns - likely: Teacher | Student | Product | Assessment`);
          }
        }
      }
    }

    // ============================================================
    // PAGES with BLOCKS (document hierarchy)
    // ============================================================
    if (visionData?.pages?.length > 0) {
      parts.push(`\n# PAGES (${visionData.pages.length})`);

      for (const page of visionData.pages.slice(0, 3)) {
        parts.push(`\n## Page ${page.pageNumber}`);
        parts.push(`Elements: ${page.elements?.length || 0}`);

        for (const elem of page.elements?.slice(0, 15) || []) {
          // Reading order
          const order = elem.readingOrder !== undefined ? `[#${elem.readingOrder}] ` : '';

          if (elem.type === 'heading') {
            parts.push(`${order}[H${elem.level || 1}] ${elem.content?.substring(0, 80) || ''}`);
          } else if (elem.type === 'paragraph') {
            parts.push(`${order}[P] ${elem.content?.substring(0, 150) || ''}`);
          } else if (elem.type === 'table') {
            parts.push(`${order}[TABLE] rows=${elem.tableData?.rows?.length || 0}`);
          } else if (elem.type === 'image') {
            parts.push(`${order}[IMAGE]`);
          }

          // Position info (bbox)
          if (elem.bbox) {
            parts.push(`    Position: (${elem.bbox.x}, ${elem.bbox.y}) ${elem.bbox.width}x${elem.bbox.height}`);
          }
        }
      }
    }

    // ============================================================
    // BLOCKS (flattened elements)
    // ============================================================
    if (visionData?.blocks?.length > 0) {
      parts.push(`\n# BLOCKS (${visionData.blocks.length})`);
      for (const block of visionData.blocks.slice(0, 20)) {
        if (block.type === 'heading') {
          parts.push(`[H${block.level}] ${block.content?.substring(0, 60)}`);
        } else if (block.type === 'paragraph') {
          parts.push(`[P] ${block.content?.substring(0, 100)}`);
        }
      }
    }

    // ============================================================
    // ACTIVITIES (if already extracted by Vision)
    // ============================================================
    if (visionData?.activities?.length > 0) {
      parts.push(`\n# ACTIVITIES (${visionData.activities.length})`);
      for (const activity of visionData.activities.slice(0, 10)) {
        parts.push(`\n## ${activity.title || 'Activity'}`);
        parts.push(`Section: ${activity.sectionTitle || 'N/A'}`);
        parts.push(`Page Numbers: ${activity.pageNumbers?.join(', ') || 'N/A'}`);
        parts.push(`Paragraphs: ${activity.paragraphCount || 0}`);

        if (activity.paragraphs && activity.paragraphs.length > 0) {
          for (const para of activity.paragraphs.slice(0, 5)) {
            const prefix = para.isHeading ? `[H${para.headingLevel}] ` : `[P] `;
            parts.push(`${prefix}${para.content?.substring(0, 100) || ''}`);
          }
        }
      }
    }

    // ============================================================
    // IMAGES
    // ============================================================
    if (visionData?.images?.length > 0) {
      parts.push(`\n# IMAGES (${visionData.images.length})`);
      for (const img of visionData.images.slice(0, 5)) {
        parts.push(`- Image: ${img.caption || 'N/A'} (Page ${img.pageNumber || 'N/A'})`);
      }
    }

    return parts.join('\n');
  }

  /**
   * Build prompt for a specific section - includes more content detail
   */
  private buildSectionPrompt(visionData: any, section: any): string {
    const parts: string[] = [];

    parts.push(`# SECTION: ${section.title}`);
    parts.push(`Type: ${section.type || 'CUSTOM'}`);
    parts.push(`Code: ${section.code || 'N/A'}`);

    // Get all activities for this section
    if (section.activities) {
      for (const activity of section.activities) {
        parts.push(`\n## Activity: ${activity.title || 'Unnamed'}`);
        parts.push(`Type: ${activity.type || 'CUSTOM'}`);

        // Full paragraphs
        if (activity.paragraphs && activity.paragraphs.length > 0) {
          parts.push(`\n### Paragraphs (${activity.paragraphs.length}):`);
          for (const para of activity.paragraphs) {
            parts.push(`- ${para.content || ''}`);
          }
        }

        // Tables in this activity
        if (activity.tables) {
          parts.push(`\n### Tables:`);
          for (const table of activity.tables) {
            if (table.headers) parts.push(`Headers: ${table.headers.join(' | ')}`);
            if (table.rows) {
              for (const row of table.rows) {
                parts.push(`Row: ${row.join(' | ')}`);
              }
            }
          }
        }
      }
    }

    // Also get content from blocks that might not be in activities
    if (section.blocks) {
      parts.push(`\n### Additional Blocks:`);
      for (const block of section.blocks) {
        if (block.content) {
          parts.push(`- ${block.content}`);
        }
      }
    }

    return parts.join('\n');
  }

  /**
   * Get the output JSON schema for semantic tree
   */
  private getSemanticTreeOutputSchema(): string {
    return `{
  "sections": [
    {
      "id": "section-1",
      "type": "MUC_TIEU|CHUAN_BI|TIEN_TRINH|DANH_GIA|PHU_LUC|CUSTOM",
      "title": "Tên section",
      "order": 1,
      "confidence": 0.95,
      "activities": [
        {
          "id": "activity-1",
          "type": "KHOI_DONG|HINH_THANH|LUYEN_TAP|VAN_DUNG|DANH_GIA|CUSTOM",
          "title": "Tên hoạt động",
          "goal": "Mục tiêu hoạt động",
          "duration": 5,
          "order": 1,
          "paragraphs": [
            {"id": "p-1", "content": "NỘI DUNG ĐẦY ĐỦ CỦA PARAGRAPH"}
          ],
          "teacherActions": [
            {"id": "ta-1", "action": "Hành động GV 1", "order": 1},
            {"id": "ta-2", "action": "Hành động GV 2", "order": 2},
            {"id": "ta-3", "action": "Hành động GV 3", "order": 3}
          ],
          "studentActions": [
            {"id": "sa-1", "action": "Hành động HS 1", "order": 1},
            {"id": "sa-2", "action": "Hành động HS 2", "order": 2}
          ],
          "questions": [
            {"id": "q-1", "content": "Câu hỏi 1", "order": 1}
          ],
          "products": [
            {"id": "p-1", "type": "BÀI_LÀM", "description": "Sản phẩm 1"},
            {"id": "p-2", "type": "BÀI_LÀM", "description": "Sản phẩm 2"}
          ],
          "assessments": [
            {"id": "a-1", "type": "QUAN_SAT", "method": "Phương pháp đánh giá"}
          ],
          "confidence": 0.9
        }
      ]
    }
  ]
}`;
  }

  private calculateConfidence(sections: any[]): number {
    if (sections.length === 0) return 0;

    const totalConfidence = sections.reduce((sum, section) => {
      const sectionConf = section.confidence || 0.8;
      const activityConfs = (section.activities || []).map((a: any) => a.confidence || 0.8);
      const avgActivity = activityConfs.length > 0
        ? activityConfs.reduce((a: number, b: number) => a + b, 0) / activityConfs.length
        : 0.8;
      return sum + (sectionConf + avgActivity) / 2;
    }, 0);

    return totalConfidence / sections.length;
  }
}

// Export singleton
export const aiDocumentParserPipeline = new AIDocumentParserPipeline();
