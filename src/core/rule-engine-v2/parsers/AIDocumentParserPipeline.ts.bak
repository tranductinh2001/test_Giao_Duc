        { "id": "ta-1", "action": "Giao nhiệm vụ cho HS", "order": 1 },
        { "id": "ta-2", "action": "Quan sát HS làm việc", "order": 2 }
      ],
      "studentActions": [
        { "id": "sa-1", "action": "Thảo luận nhóm", "order": 1 },
        { "id": "sa-2", "action": "Trình bày kết quả", "order": 2 }
      ],
      "questions": [
        { "id": "q-1", "content": "Câu hỏi?", "order": 1 }
      ],
      "products": [
        { "id": "p-1", "type": "PHIEU_HOC_TAP", "description": "Phiếu học tập" }
      ],
      "assessments": [
        { "id": "a-1", "type": "OBSERVATION", "method": "Quan sát", "evidence": "Cách HS thảo luận", "criteria": "Hoàn thành nhiệm vụ" }
      ],
      "confidence": 0.9,
      "matchedBecause": "Contains keywords: thảo luận nhóm, trình bày"
    }
  ]
}`;

// ============================================================================
