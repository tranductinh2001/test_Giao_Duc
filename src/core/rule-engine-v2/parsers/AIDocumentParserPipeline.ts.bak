/**
 * AI Document Parser Pipeline
 *
 * Complete refactoring of AI parsing into a multi-stage pipeline:
 *
 * 1. OCR Cleanup     - Fix OCR errors, merge lines, remove headers/footers
 * 2. Semantic Normalize - Standardize terminology (GV → Giáo viên, etc.)
 * 3. Document Parser - Build Document → Section hierarchy
 * 4. Activity Parser  - Parse Activities with Teacher/Student actions
 * 5. Relationship Builder - Link paragraphs to activities to sections
 * 6. Validation       - Check for missing elements
 *
 * Each prompt does ONE thing - not multiple tasks.
 */

import { BeekOneAIClient, type AIResult } from '@/lib/beekone-ai-client';

export interface AIDocumentParseResult {
  success: boolean;
  document?: AIDocument;
  sections?: any[]; // For backward compatibility
  tree?: DocumentTree; // Semantic tree
  pipelineMetrics?: PipelineMetrics;
  confidence: number;
  error?: string;
}

export interface PipelineMetrics {
  ocrCleanupTime: number;
  normalizeTime: number;
  documentParseTime: number;
  activityParseTime: number;
  relationshipTime: number;
  validationTime: number;
  totalTime: number;
  promptTokens: number;
  completionTokens: number;
  totalTokens: number;
  estimatedCost: number;
}

export interface AIDocument {
  id: string;
  title: string;
  metadata: DocumentMetadata;
  sections: AISection[];
}

export interface DocumentMetadata {
  totalPages?: number;
  wordCount?: number;
  language?: string;
  hasTables?: boolean;
  hasImages?: boolean;
  originalFormat?: string;
}

export interface AISection {
  id: string;
  type: string;
  title: string;
  order: number;
  activities: AIActivity[];
  paragraphs: AIParagraph[];
  confidence: number;
}

export interface AIActivity {
  id: string;
  type: string;
  title: string;
  goal?: string;
  duration?: number;
  order: number;
  teacherActions: TeacherAction[];
  studentActions: StudentAction[];
  questions: Question[];
  products: LearningProduct[];
  assessments: Assessment[];
  paragraphs: AIParagraph[];
  resources?: string[];
  confidence: number;
  matchedBecause?: string;
}

export interface TeacherAction {
  id: string;
  action: string;
  order: number;
}

export interface StudentAction {
  id: string;
  action: string;
  order: number;
}

export interface Question {
  id: string;
  content: string;
  order: number;
}

export interface LearningProduct {
  id: string;
  type: string;
  description: string;
}

export interface Assessment {
  id: string;
  type: string;
  method: string;
  evidence?: string;
  criteria?: string;
}

export interface AIParagraph {
  id: string;
  content: string;
  type: string;
  order: number;
  startOffset: number;
  endOffset: number;
  parentId?: string;
  parentType?: 'activity' | 'section';
}

export interface DocumentTree {
  root: TreeNode;
  sections: TreeNode[];
  activities: TreeNode[];
}

export interface TreeNode {
  id: string;
  type: 'document' | 'section' | 'activity' | 'teacher_action' | 'student_action' | 'question' | 'product' | 'assessment' | 'paragraph';
  title: string;
  content?: string;
  order: number;
  level: number;
  children: TreeNode[];
  metadata?: Record<string, any>;
  confidence: number;
  parentId?: string;
}

export interface AIDocumentParseRequest {
  documentText?: string; // Optional - only used when no visionData
  documentTitle?: string;
  visionData?: any; // Vision JSON data for semantic reasoning
  context?: {
    subject?: string;
    gradeLevel?: string;
    lessonDuration?: number;
  };
}

// ============================================================================
// PROMPT 1: OCR CLEANUP
// ============================================================================

const OCR_CLEANUP_SYSTEM = `You are an OCR cleanup expert. Your ONLY task is to fix OCR errors in Vietnamese lesson plan documents.

RULES:
1. Do NOT change content - only fix OCR errors
2. Merge broken lines that should be together
3. Remove page numbers, headers, footers, watermarks
4. Fix garbled characters (e.g., "một" → "một", "đường" → "đường")
5. Fix spacing issues
6. Preserve original meaning

OUTPUT: Clean text only, no explanations.`;

const OCR_CLEANUP_USER = (text: string) => `Fix OCR errors in this Vietnamese lesson plan:

${text}

Return ONLY cleaned text, no JSON, no explanations.`;

// ============================================================================
// PROMPT 2: SEMANTIC NORMALIZE
// ============================================================================

const SEMANTIC_NORMALIZE_SYSTEM = `You are a Vietnamese terminology normalizer for lesson plans.

Your task: Standardize terminology while keeping original meaning.

TERM MAPPINGS TO APPLY:
- "GV" / "Giáo viên" / "Giáo Vien" / "G.V" → "Giáo viên"
- "HS" / "Học sinh" / "Học Sinh" / "H.S" → "Học sinh"
- "Hoạt động khởi động" / "Khởi động" / "Warm up" / "Warm-up" → "Hoạt động khởi động"
- "Hoạt động hình thành kiến thức" / "Hình thành KT" / "Hình thành kiến thức" → "Hoạt động hình thành kiến thức"
- "Hoạt động luyện tập" / "Luyện tập" / "Luyện Tập" → "Hoạt động luyện tập"
- "Hoạt động vận dụng" / "Vận dụng" / "Vân dụng" → "Hoạt động vận dụng"
- "Củng cố" / "Củng cố" / "Củng cố bài" → "Củng cố"
- "Về nhà" / "Về nhà làm bài tập" / "Dặn dò" → "Hướng dẫn về nhà"
- "Mục tiêu" / "Muc tieu" / "Yêu cầu cần đạt" → "Mục tiêu"
- "Kiến thức" / "Kien thuc" → "Kiến thức"
- "Kỹ năng" / "Ky nang" → "Kỹ năng"
- "Phẩm chất" / "Pham chat" → "Phẩm chất"
- "Năng lực" / "Nang luc" → "Năng lực"

OUTPUT: Return cleaned text with normalized terms.`;

const SEMANTIC_NORMALIZE_USER = (text: string) => `Normalize terminology in this lesson plan:

${text}

Return normalized text only, no JSON, no explanations.`;

// ============================================================================
// PROMPT 3: DOCUMENT PARSER
// ============================================================================

const DOCUMENT_PARSER_SYSTEM = `You are a Vietnamese lesson plan structure analyzer.

Your task: Identify the DOCUMENT STRUCTURE only.

Identify:
1. SECTIONS: Major parts (Mục tiêu, Chuẩn bị, Tiến trình, etc.)
2. For each section: determine type and boundaries
3. DO NOT parse activities yet - just sections

SECTION TYPES:
- OBJECTIVES / MỤC TIÊU
- PREPARATION / CHUẨN BỊ (Thiết bị, Học liệu)
- PROCEDURE / TIẾN TRÌNH (Các hoạt động)
- HOMEWORK / VỀ NHÀ / CỦNG CỐ

OUTPUT: Return JSON only, no markdown, no explanations.`;

const DOCUMENT_PARSER_USER = (text: string) => `Identify sections in this Vietnamese lesson plan:

${text}

Return JSON:
{
  "sections": [
    {
      "id": "section-1",
      "type": "OBJECTIVES|PREPARATION|PROCEDURE|HOMEWORK|CUSTOM",
      "title": "Section title",
      "order": 1,
      "startLine": 0,
      "endLine": 10,
      "confidence": 0.95
    }
  ]
}`;

// ============================================================================
