// PROMPT 6: VALIDATION
// ============================================================================

const VALIDATION_SYSTEM = `You are a Vietnamese lesson plan validator.

Your task: Check for structural issues and completeness.

VALIDATION RULES:
1. If Teacher Action exists, Student Action should exist
2. If Activity exists, it should have Teacher AND Student actions
3. Each Activity should have at least one assessment or product
4. Sections should be in logical order
5. No orphaned paragraphs (paragraphs not belonging to any activity)

OUTPUT: Return JSON only, no markdown, no explanations.`;

const VALIDATION_USER = (document: any) => `Validate this lesson plan structure:

${JSON.stringify(document, null, 2)}

Return JSON:
{
  "valid": true,
  "issues": [
    {
      "type": "WARNING|ERROR",
      "location": "activity-1",
      "message": "Activity has no student actions",
      "severity": "HIGH|MEDIUM|LOW"
    }
  ],
  "statistics": {
    "totalSections": 5,
    "totalActivities": 8,
    "totalTeacherActions": 15,
    "totalStudentActions": 12,
    "totalQuestions": 5,
    "totalProducts": 3,
    "totalAssessments": 6
  }
}`;

// ============================================================================
// MAIN PARSER CLASS
// ============================================================================

export class AIDocumentParserPipeline {
  private aiClient: BeekOneAIClient;
  private enableCache: boolean = true;

  constructor(options?: { apiKey?: string; baseUrl?: string; model?: string; cache?: boolean }) {
    this.aiClient = new BeekOneAIClient(options);
    if (options?.cache !== undefined) {
      this.enableCache = options.cache;
    }
  }

  isAvailable(): boolean {
    return this.aiClient.isAvailable();
  }

  async parse(request: AIDocumentParseRequest): Promise<AIDocumentParseResult> {
    const startTime = Date.now();
    const metrics: PipelineMetrics = {
      ocrCleanupTime: 0,
      normalizeTime: 0,
      documentParseTime: 0,
      activityParseTime: 0,
      relationshipTime: 0,
      validationTime: 0,
      totalTime: 0,
      promptTokens: 0,
      completionTokens: 0,
      totalTokens: 0,
      estimatedCost: 0,
    };

    try {
      // Check if we have Vision JSON data - use Semantic Reasoner path
      if (request.visionData) {
        return this.parseWithVisionData(request, metrics);
      }

      // Fallback: If no visionData, use documentText (legacy path)
      if (!request.documentText) {
        console.error('[AI Parser Pipeline] No visionData and no documentText provided');
        return {
          success: false,
          confidence: 0,
          error: 'Either visionData or documentText must be provided',
        };
      }

      // Step 1: OCR Cleanup
      console.log('[AI Parser Pipeline] Step 1: OCR Cleanup...');
      const ocrStart = Date.now();
      let cleanedText = request.documentText;

      const ocrResult = await this.aiClient.complete(OCR_CLEANUP_USER(request.documentText), {
        temperature: 0.1,
        maxTokens: 8000,
        systemPrompt: OCR_CLEANUP_SYSTEM,
      });

      if (ocrResult.success && ocrResult.data) {
        cleanedText = ocrResult.data;
      }
      metrics.ocrCleanupTime = Date.now() - ocrStart;
      console.log('[AI Parser Pipeline] OCR Cleanup:', metrics.ocrCleanupTime + 'ms');

      // Step 2: Semantic Normalize
      console.log('[AI Parser Pipeline] Step 2: Semantic Normalize...');
      const normalizeStart = Date.now();
      let normalizedText = cleanedText;

      const normalizeResult = await this.aiClient.complete(SEMANTIC_NORMALIZE_USER(cleanedText), {
        temperature: 0.1,
        maxTokens: 8000,
        systemPrompt: SEMANTIC_NORMALIZE_SYSTEM,
      });

      if (normalizeResult.success && normalizeResult.data) {
        normalizedText = normalizeResult.data;
      }
      metrics.normalizeTime = Date.now() - normalizeStart;
      console.log('[AI Parser Pipeline] Semantic Normalize:', metrics.normalizeTime + 'ms');

      // Step 3: Document Parser
      console.log('[AI Parser Pipeline] Step 3: Document Parser...');
      const docParseStart = Date.now();

      const docResult = await this.aiClient.complete(DOCUMENT_PARSER_USER(normalizedText), {
        temperature: 0.1,
        maxTokens: 4000,
        systemPrompt: DOCUMENT_PARSER_SYSTEM,
      });

      let sections: any[] = [];
      if (docResult.success && docResult.data) {
        try {
          const parsed = JSON.parse(docResult.data);
          sections = parsed.sections || [];
        } catch (e) {
          console.error('[AI Parser Pipeline] Failed to parse document structure:', e);
        }
      }
      metrics.documentParseTime = Date.now() - docParseStart;
      console.log('[AI Parser Pipeline] Document Parser:', metrics.documentParseTime + 'ms, ' + sections.length + ' sections');

      // Step 4: Activity Parser
      console.log('[AI Parser Pipeline] Step 4: Activity Parser...');
      const activityStart = Date.now();

      for (const section of sections) {
        const activityResult = await this.aiClient.complete(
          ACTIVITY_PARSER_USER(section.content || '', section.type),
          {
            temperature: 0.1,
            maxTokens: 4000,
            systemPrompt: ACTIVITY_PARSER_SYSTEM,
              }
        );

        if (activityResult.success && activityResult.data) {
          try {
            const parsed = JSON.parse(activityResult.data);
            section.activities = parsed.activities || [];
          } catch (e) {
            console.error('[AI Parser Pipeline] Failed to parse activities for section', section.id, e);
          }
        }
      }
      metrics.activityParseTime = Date.now() - activityStart;
      console.log('[AI Parser Pipeline] Activity Parser:', metrics.activityParseTime + 'ms');

      // Step 5: Relationship Builder
      console.log('[AI Parser Pipeline] Step 5: Relationship Builder...');
      const relStart = Date.now();

      // Build paragraphs from activities
      const paragraphs: any[] = [];
      const activities: any[] = [];

      for (const section of sections) {
        for (const activity of section.activities || []) {
          activities.push({ ...activity, sectionId: section.id });

          // Add activity content as paragraph
          paragraphs.push({
            id: `p-${activity.id}`,
            content: activity.title,
            parentId: activity.id,
            parentType: 'activity',
          });

          // Add teacher/student actions as paragraphs
          for (const ta of activity.teacherActions || []) {
            paragraphs.push({
              id: ta.id,
              content: ta.action,
              parentId: activity.id,
              parentType: 'activity',
              role: 'TEACHER_ACTION',
            });
          }

          for (const sa of activity.studentActions || []) {
            paragraphs.push({
              id: sa.id,
              content: sa.action,
              parentId: activity.id,
              parentType: 'activity',
              role: 'STUDENT_ACTION',
            });
          }
        }
      }

      const relResult = await this.aiClient.complete(RELATIONSHIP_BUILDER_USER(paragraphs, activities), {
        temperature: 0.1,
        maxTokens: 2000,
        systemPrompt: RELATIONSHIP_BUILDER_SYSTEM,
      });

      if (relResult.success && relResult.data) {
        try {
          const parsed = JSON.parse(relResult.data);
          // Apply relationships
        } catch (e) {
          console.error('[AI Parser Pipeline] Failed to build relationships:', e);
        }
      }
      metrics.relationshipTime = Date.now() - relStart;
      console.log('[AI Parser Pipeline] Relationship Builder:', metrics.relationshipTime + 'ms');

      // Step 6: Validation
      console.log('[AI Parser Pipeline] Step 6: Validation...');
      const validationStart = Date.now();

      const validationResult = await this.aiClient.complete(VALIDATION_USER({ sections }), {
        temperature: 0.1,
        maxTokens: 2000,
        systemPrompt: VALIDATION_SYSTEM,
      });

      let validationIssues: any[] = [];
      if (validationResult.success && validationResult.data) {
        try {
          const parsed = JSON.parse(validationResult.data);
          validationIssues = parsed.issues || [];
        } catch (e) {
          console.error('[AI Parser Pipeline] Failed to validate:', e);
        }
      }
      metrics.validationTime = Date.now() - validationStart;
      console.log('[AI Parser Pipeline] Validation:', metrics.validationTime + 'ms, ' + validationIssues.length + ' issues');

      // Calculate metrics
      metrics.totalTime = Date.now() - startTime;

      // Build final document
      const docId = 'doc-' + Date.now();
      const document: AIDocument = {
        id: docId,
        title: request.documentTitle || 'Untitled',
        metadata: {
          wordCount: normalizedText.split(/\s+/).length,
          language: 'vi',
        },
        sections: sections as AISection[],
      };

      const confidence = this.calculateConfidence(sections);

      console.log('[AI Parser Pipeline] Complete:', metrics.totalTime + 'ms, confidence: ' + (confidence * 100).toFixed(1) + '%');

      return {
        success: true,
        document,
        pipelineMetrics: metrics,
        confidence,
      };

    } catch (error) {
      console.error('[AI Parser Pipeline] Error:', error);
      return {
        success: false,
        confidence: 0,
        error: error instanceof Error ? error.message : 'Pipeline failed',
      };
    }
  }

  /**
   * SEMANTIC REASONING using Vision JSON data
   *
   * This is NOT document parsing or OCR.
   * This is semantic reasoning over Vision JSON data.
   *
   * The Vision AI has already:
   * - Read the PDF/Image
   * - Extracted structure (pages, blocks, tables)
   * - Identified elements (headings, paragraphs, tables)
   *
   * This AI's job is to:
   * - Reason over the structured Vision JSON
   * - Extract semantic meaning
   * - Generate Semantic Document Tree
   */
  private async parseWithVisionData(
    request: AIDocumentParseRequest,
    metrics: PipelineMetrics
  ): Promise<AIDocumentParseResult> {
    const startTime = Date.now();
    const visionData = request.visionData;

    console.log('[SemanticReasoner] Using Vision JSON for semantic reasoning...');

    // Build structured prompt from Vision JSON
    const structuredPrompt = this.buildVisionPrompt(visionData);

    // Calculate character count to determine if chunking is needed
    const promptSize = structuredPrompt.length;
    const needsChunking = promptSize > 15000; // If > 15K chars, chunk by section

    let sections: any[] = [];

    if (needsChunking) {
      console.log('[SemanticReasoner] Large document detected (' + promptSize + ' chars), using chunked parsing');

      // Chunk by sections from visionData
      const visionSections = visionData?.sections || [];
      for (const section of visionSections) {
        console.log('[SemanticReasoner] Processing section:', section.title);

        // Build section-specific prompt
        const sectionPrompt = this.buildSectionPrompt(visionData, section);
        const sectionPromptText = `Bạn là chuyên gia SEMANTIC CONTENT PRESERVATION cho giáo án.

NHIỆM VỤ DUY NHẤT: Tổ chức lại cấu trúc, KHÔNG tóm tắt, KHÔNG bỏ nội dung.

YÊU CẦU TUYỆT ĐỐI:
- Giữ nguyên 100% nội dung gốc
- Tất cả paragraph phải được copy đầy đủ
- Tất cả dòng trong bảng phải được copy đầy đủ
- Tất cả teacher actions phải được giữ lại (KHÔNG chọn lọc)
- Tất cả student actions phải được giữ lại (KHÔNG chọn lọc)
- Tất cả products, assessments, questions phải được giữ lại

ĐÂY LÀ SEMANTIC STRUCTURING, KHÔNG PHẢI SUMMARIZATION

DỮ LIỆU:
${sectionPrompt}

OUTPUT (JSON):
${this.getSemanticTreeOutputSchema()}`;

        const result = await this.aiClient.complete(sectionPromptText, {
          temperature: 0.1,
          maxTokens: 16000,
          systemPrompt: `Bạn là chuyên gia SEMANTIC CONTENT PRESERVATION.
- KHÔNG TÓM TẮT
- KHÔNG RÚT GỌN
- KHÔNG BỎ NỘI DUNG
- Giữ nguyên 100% nội dung
- Trả về JSON hợp lệ`,
        });

        if (result.success && result.data) {
          try {
            let cleanData = result.data.trim();
            if (cleanData.startsWith('```json')) cleanData = cleanData.slice(7);
            if (cleanData.startsWith('```')) cleanData = cleanData.slice(3);
            if (cleanData.endsWith('```')) cleanData = cleanData.slice(0, -3);
            cleanData = cleanData.trim();

            const parsed = JSON.parse(cleanData);
            const parsedSections = parsed.sections || parsed.activities || [];
            sections.push(...parsedSections);
          } catch (e) {
            console.error('[SemanticReasoner] Failed to parse section', section.title, e);
          }
        }
      }
    } else {
      // Single prompt for smaller documents
      const prompt = `Bạn là chuyên gia SEMANTIC CONTENT PRESERVATION cho giáo án.

NHIỆM VỤ DUY NHẤT: Tổ chức lại cấu trúc ngữ nghĩa, KHÔNG tóm tắt, KHÔNG bỏ nội dung.

YÊU CẦU TUYỆT ĐỐI:
1. Giữ nguyên 100% nội dung gốc - KHÔNG tóm tắt
2. Tất cả paragraph phải được copy đầy đủ
3. Tất cả dòng trong bảng phải được copy đầy đủ
4. Tất cả teacher actions phải được giữ lại (tất cả, KHÔNG chọn lọc)
5. Tất cả student actions phải được giữ lại (tất cả, KHÔNG chọn lọc)
6. Tất cả products, assessments, questions phải được giữ lại
7. Semantic Tree = TÁI CẤU TRÚC nội dung, KHÔNG PHẢI tóm tắt

ĐÂY LÀ SEMANTIC STRUCTURING - GIỮ NGUYÊN 100% NỘI DUNG

DỮ LIỆU VISION JSON:
${structuredPrompt}

OUTPUT (JSON):
{
  "sections": [
    {
      "id": "section-1",
      "type": "MUC_TIEU|CHUAN_BI|TIEN_TRINH|DANH_GIA|PHU_LUC|CUSTOM",
      "title": "Tên section",
      "order": 1,
      "confidence": 0.95,
      "activities": [
        {
          "id": "activity-1",
          "type": "KHOI_DONG|HINH_THANH|LUYEN_TAP|VAN_DUNG|DANH_GIA|CUSTOM",
          "title": "Tên hoạt động",
          "goal": "Mục tiêu hoạt động",
          "duration": 5,
          "order": 1,
          "paragraphs": [
            {"id": "p-1", "content": "NỘI DUNG ĐẦY ĐỦ CỦA ĐOẠN VĂN - GIỮ NGUYEN 100%"},
            {"id": "p-2", "content": "NỘI DUNG ĐẦY ĐỦ - KHÔNG TÓM TẮT"}
          ],
          "teacherActions": [
            { "id": "ta-1", "action": "Hành động của GV", "order": 1 }
          ],
          "studentActions": [
            { "id": "sa-1", "action": "Hành động của HS", "order": 1 }
          ],
          "questions": [
            { "id": "q-1", "content": "Câu hỏi?", "order": 1 }
          ],
          "products": [
            { "id": "p-1", "type": "BÀI_LÀM", "description": "Sản phẩm HS tạo ra" }
          ],
          "assessments": [
            { "id": "a-1", "type": "QUAN_SAT", "method": "Phương pháp đánh giá", "evidence": "Bằng chứng", "criteria": "Tiêu chí" }
          ],
          "confidence": 0.9
        }
      ]
