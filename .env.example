# Environment Variables for Production

# Database
DATABASE_URL="postgresql://..."

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-min-32-chars"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# Email Service (Resend)
RESEND_API_KEY="re_..."

# ONLYOFFICE Document Server
ONLYOFFICE_SERVER_URL="http://localhost:80"
ONLYOFFICE_JWT_SECRET="your-onlyoffice-jwt-secret-min-32-chars"
NEXT_PUBLIC_ONLYOFFICE_SERVER_URL="http://localhost:80"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Provider for Lesson Plan Suggestions
# Options: "beeknoee" (recommended) or "gemini"
AI_SUGGESTION_PROVIDER="beeknoee"

# Beeknoee AI (used when AI_SUGGESTION_PROVIDER="beeknoee")
BEE_API_KEY="your-beeknoee-api-key"
BEE_BASE_URL="https://platform.beeknoee.com/api/v1"

# Google Gemini API (used when AI_SUGGESTION_PROVIDER="gemini")
GEMINI_API_KEY="your-gemini-api-key"

# AI Model Configuration (for both providers)
AI_SUGGESTION_MODEL="gemini-3.1-flash-lite"
AI_MODEL="gemini-3.1-flash-lite"

# Optional: Monitoring
SENTRY_DSN="https://..."
LOGROCKET_APP_ID="..."
